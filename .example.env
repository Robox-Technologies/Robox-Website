STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Set true to make the server-side caches (Stripe products, AusPost quotes) never
# expire, so a build or an offline session reads each upstream API once. Leave
# false in production, where the caches run on their own short TTLs.
FORCE_CACHE=false

EMAIL_HOST=smtp.example.com
EMAIL_PORT=123
EMAIL_SECURE=true
EMAIL_USER=hello@example.com
EMAIL_PASS=...

RESEND_KEY=re_...

CMS_URL=http://localhost:3333
WEBSITE_PORT=3000
AUSPOST_KEY=...
AUSPOST_ORIGIN_POSTCODE=3184


# Origin this build will be served from. Drives canonical links, the og:image
# URL and the sitemap. Defaults to https://robox.com.au; set it for any other
# host (e.g. https://dev.robox.com.au), which also marks the build noindex.
SITE_URL=https://robox.com.au
