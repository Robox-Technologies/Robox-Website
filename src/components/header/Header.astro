---
import Clipper from '../Clipper'
import HeaderLink from './HeaderLink'
import Logo from '@/images/logo-full.svg?react'
import WorkshopLogo from '@/images/logo-workshop.svg?react'
import { faCompass, faGraduationCap } from '@fortawesome/free-solid-svg-icons'
import StoreLink from './StoreLink'
import CartIcon from '@/components/shop/cart/CartIcon'

interface Props {
    type?: 'standard' | 'workshop'
}

const { type = 'standard' } = Astro.props as Props
const isWorkshop = type === 'workshop'

const headerHeight = 64
const headerEndPadding = 16
const extraClipperPadding = 32
const overhang = `${(headerEndPadding + extraClipperPadding) / 2}px`
---

<header
    class={`sticky top-0 z-50 flex w-full items-center justify-between ${isWorkshop ? 'bg-blue' : 'bg-primary'}`}
    style={`height: ${headerHeight}px`}
>
    <nav
        class="flex h-full w-full flex-row items-center font-medium text-lg"
        style={`margin-left: ${headerEndPadding}px`}
    >
        <div class="flex flex-row items-center space-x-6">
            <a href="/" class="flex items-center p-4">
                {isWorkshop ? (
                    <WorkshopLogo className="h-8 w-auto" />
                ) : (
                    <Logo className="h-8 w-auto" />
                )}
            </a>
            <HeaderLink
                href="/about"
                className={`max-[1050px]:hidden ${isWorkshop ? 'text-white' : ''}`}
            >
                About
            </HeaderLink>
            <HeaderLink
                href="#contactUs"
                className={`max-[1050px]:hidden ${isWorkshop ? 'text-white' : ''}`}
            >
                Contact
            </HeaderLink>
        </div>
        <Clipper
            className={`ml-auto h-full ${isWorkshop ? 'bg-red' : 'bg-blue'}`}
            gradient="positive"
            side="left"
            overhang={overhang}
        >
            <div
                class="links flex h-full items-center space-x-6 text-white"
                style={`padding-left: ${headerEndPadding + extraClipperPadding}px; padding-right: ${headerEndPadding + extraClipperPadding}px`}
            >
                <HeaderLink
                    icon={faCompass}
                    className="text-white max-[1050px]:hidden"
                    href="/hub"
                >
                    Ro/Box Hub
                </HeaderLink>
                <HeaderLink
                    icon={faGraduationCap}
                    className="text-white max-[1050px]:hidden"
                    href="/teacher"
                >
                    Teacher Resources
                </HeaderLink>
                {type === 'standard' && (
                    <StoreLink className="max-[1050px]:hidden" />
                )}
                {!isWorkshop ? (
                    <CartIcon client:only="react">
                        <span
                            slot="fallback"
                            class="block h-10 w-10"
                            aria-hidden="true"
                        ></span>
                    </CartIcon>
                ) : null}
                <button
                    id="mobile-menu-toggle"
                    type="button"
                    aria-label="Toggle menu"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                    class="hamburger button-interactive button-interactive-light rounded-md hidden max-[1050px]:flex text-white"
                >
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </Clipper>
    </nav>

    <div
        id="mobile-menu"
        class={`mobile-menu absolute left-0 top-full flex w-full flex-col gap-4 border-b border-secondary px-8 py-6 min-[1050px]:hidden ${isWorkshop ? 'bg-blue' : 'bg-primary'}`}
    >
        <HeaderLink
            href="/about"
            className={isWorkshop ? 'text-white' : ''}
        >
            About
        </HeaderLink>
        <HeaderLink
            href="#contactUs"
            className={isWorkshop ? 'text-white' : ''}
        >
            Contact
        </HeaderLink>
        <HeaderLink icon={faCompass} href="/hub">
            Ro/Box Hub
        </HeaderLink>
        <HeaderLink icon={faGraduationCap} href="/teacher">
            Teacher Resources
        </HeaderLink>
        {type === 'standard' && <StoreLink className="w-fit" />}
    </div>
</header>

<style>
    /* Three-bar hamburger that morphs into an X when open. */
    .hamburger {
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 32px;
        height: 32px;
        padding: 0;
        background: none;
        border: none;
        cursor: pointer;
    }
    .hamburger span {
        display: block;
        width: 22px;
        height: 2px;
        border-radius: 2px;
        /* The base layer colours every `span` dark, which beat the button's
           text-white — take the button's colour back so the bars read on the
           blue (or red) block they sit in. */
        color: inherit;
        background: currentColor;
        transition:
            transform 0.25s ease,
            opacity 0.2s ease;
    }
    .hamburger.open span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .hamburger.open span:nth-child(2) {
        opacity: 0;
    }
    .hamburger.open span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* Slide-down dropdown. Kept in the DOM (absolute) but hidden from view and
     * the a11y tree until opened. */
    .mobile-menu {
        visibility: hidden;
        opacity: 0;
        transform: translateY(-8px);
        /* `visibility` has to be in the transition or it snaps to hidden on
           close and the slide-up never plays. Discrete interpolation keeps it
           visible for the whole duration, so the menu animates out as well. */
        transition:
            transform 0.25s ease,
            opacity 0.25s ease,
            visibility 0.25s ease;
    }
    .mobile-menu.open {
        visibility: visible;
        opacity: 1;
        transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
        .hamburger span,
        .mobile-menu {
            transition: none;
        }
    }
</style>

<script>
    const btn = document.getElementById('mobile-menu-toggle')
    const menu = document.getElementById('mobile-menu')

    if (btn && menu) {
        const setOpen = (open: boolean) => {
            menu.classList.toggle('open', open)
            btn.classList.toggle('open', open)
            btn.setAttribute('aria-expanded', String(open))
        }

        btn.addEventListener('click', (event) => {
            event.stopPropagation()
            setOpen(!menu.classList.contains('open'))
        })

        // Close when clicking outside or pressing Escape.
        document.addEventListener('click', (event) => {
            if (
                menu.classList.contains('open') &&
                !menu.contains(event.target as Node) &&
                !btn.contains(event.target as Node)
            ) {
                setOpen(false)
            }
        })
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') setOpen(false)
        })
    }
</script>
