---
/**
 * Card for a CMS content item. The whole card is the link, so the CTA is a <span>.
 * Plain markup rather than the React `Card`: Astro drops conditional slot content
 * when the host is a framework component. Classes mirror `card.tsx`.
 */
import { faChevronRight } from '@fortawesome/free-solid-svg-icons'
import type { CMSItem } from '@/utils/server/cms.server'
import { itemHref } from '@/utils/server/cms.server'

interface Props {
    item: CMSItem
}

const { item } = Astro.props
const href = itemHref(item)
const [width, height, , , path] = faChevronRight.icon
const chevron = Array.isArray(path) ? path.join(' ') : path
// Resources are files served by the CMS; open those in a new tab like the
// original did, but keep generated article pages in the same one.
const external = item.type === 'resource'
// An item with no link has nothing to click, so it stays an inert <div>.
const Wrapper = href ? 'a' : 'div'
---

<Wrapper
    class:list={[
        'card resource-card box-shadow flex w-62.5 max-w-[350px] flex-col overflow-hidden rounded-3xl bg-white',
        href && 'card-interactive',
    ]}
    {...href
        ? {
              href,
              ...(external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {}),
          }
        : {}}
>
    {
        item.thumbnailUrl && (
            <img
                src={item.thumbnailUrl}
                alt=""
                loading="lazy"
                class="aspect-video w-full object-cover"
            />
        )
    }
    <div class="card-children flex flex-1 flex-col gap-2 pb-4">
        <div class="card-content flex flex-col p-4">
            <div class="card-top-row mb-2 flex items-center justify-between">
                <h2 class="text-xl font-bold">{item.previewTitle}</h2>
            </div>
        </div>
        {
            href && (
                <div class="mt-auto px-4">
                    <span class="cta inline-flex items-center gap-2 text-base font-semibold">
                        <span class="underline-grow">{item.callToAction}</span>
                        <svg
                            class="h-3 w-3 shrink-0"
                            viewBox={`0 0 ${width} ${height}`}
                            aria-hidden="true"
                        >
                            <path d={chevron} fill="currentColor" />
                        </svg>
                    </span>
                </div>
            )
        }
    </div>
</Wrapper>

<style>
    /* The original's `underline-grow`: the rule sweeps out from the left. */
    .underline-grow {
        background-image: linear-gradient(currentColor, currentColor);
        background-position: 0 100%;
        background-repeat: no-repeat;
        background-size: var(--underline-width, 0) 2px;
        transition: background-size 0.2s ease-out;
        padding-bottom: 2px;
    }

    /* Driven by the card, not the CTA: pointing anywhere on the card is what
       arms the click, so that's what the underline should answer to. Hover is
       gated on a real pointer so a tap doesn't leave it stuck on. */
    @media (hover: hover) {
        .resource-card:hover .underline-grow {
            --underline-width: 100%;
        }
    }
    .resource-card:focus-visible .underline-grow {
        --underline-width: 100%;
    }

    @media (prefers-reduced-motion: reduce) {
        .underline-grow {
            transition: none;
        }
    }
</style>
