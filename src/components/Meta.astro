---
/**
 * Everything that goes in `<head>`: title, description, Open Graph and Twitter tags.
 * Needs `site` set in astro.config.ts, or the absolute-URL construction below throws.
 */
import { DEFAULT_DESCRIPTION, isNoindex, isProductionOrigin } from '@/data/seo'

interface Props {
    title: string
    /** Used for the meta and both social descriptions. Keep it under `DESCRIPTION_LIMIT`. */
    description?: string
    /** Escape hatch for a route deciding at build time; static routes belong in `NOINDEX_PATHS`. */
    noindex?: boolean
}

const SITE_NAME = 'Ro/Box'

/**
 * From `public/` so the URL never changes — unfurlers cache OG images hard.
 * The dimensions must be kept in step with the actual file.
 */
const OG_IMAGE = {
    path: '/og-image.jpg',
    width: 1200,
    height: 630,
    alt: 'Two Ro/Box robots parked on a bench at the beach, one built from plywood and one from a cardboard box',
}

/**
 * A dev deploy gets `noindex` on every page, so it can't compete with production.
 */
const isProduction = isProductionOrigin(Astro.site)

const {
    title,
    description = DEFAULT_DESCRIPTION,
    noindex = !isProduction || isNoindex(Astro.url.pathname),
} = Astro.props

// Titles that already say "Ro/Box" don't need it twice.
const pageTitle = title.includes(SITE_NAME)
    ? title
    : `${title} | ${SITE_NAME}`

const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImageUrl = new URL(OG_IMAGE.path, Astro.site)
---

<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- PNG fallback for browsers that don't take an SVG favicon; they pick the
     best `icon` they understand, so this only gets used where it's needed. -->
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png" />
<!-- iOS home screen. Kept at the conventional root filename, which is also
     where Safari looks when a page declares no icon at all. -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<!-- Android home screen; the 192 and 512 icons are declared in here. -->
<link rel="manifest" href="/site.webmanifest" />

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta
    name="keywords"
    content="Robox, Ro/Box, robotics, Python, line following, line-following, Rise Project, low-cost robotics, cheap robotics kit, robotics kit, RCJA, RoboCup, RoboCupJunior, RoboCup Junior Australia, STEM kit, STEM"
/>
<meta name="author" content="Ro/Box" />
<meta name="copyright" content="All content copyright © 2025 Ro/Box" />
<meta name="theme-color" content="#F8F8F8" />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_AU" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:secure_url" content={ogImageUrl.href} />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE.height)} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={OG_IMAGE.alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="twitter:image:alt" content={OG_IMAGE.alt} />
