---
/**
 * Everything that goes in `<head>`: the document title, the search-engine
 * description, and the Open Graph / Twitter tags link unfurlers read.
 *
 * Was a React component; it's Astro now because the social tags need absolute
 * URLs, and `Astro.site` / `Astro.url` are the only places those come from.
 * (`site` is set in astro.config.ts — without it `new URL()` below throws,
 * which is the loud failure we want rather than silently shipping a relative
 * `og:image` that no crawler can resolve.)
 */
import { DEFAULT_DESCRIPTION, isNoindex } from '@/data/seo'

interface Props {
    title: string
    /**
     * The page's own description, used for `<meta name="description">` and both
     * social descriptions so they can't drift apart. Keep it under
     * `DESCRIPTION_LIMIT`; the OG validators truncate past that.
     */
    description?: string
    /**
     * Force the page out of search results. Normally left alone: the routes that
     * need it are listed in `NOINDEX_PATHS`, which also keeps them out of the
     * sitemap. This is the escape hatch for a route that has to decide at build
     * time (an unpublished CMS article, say).
     */
    noindex?: boolean
}

const SITE_NAME = 'Ro/Box'

/**
 * Served straight from `public/`, not imported from `src/images/`. An imported
 * asset gets a content hash in its filename, so its URL changes every time the
 * picture is touched — and unfurlers cache OG images hard, which leaves every
 * link shared before the change pointing at a 404. This path never moves.
 * The dimensions are the real ones for that file and have to be kept in step
 * with it; they're what Facebook and LinkedIn lay the preview card out from.
 */
const OG_IMAGE = {
    path: '/og-image.jpg',
    width: 1200,
    height: 630,
    alt: 'Two Ro/Box robots parked on a bench at the beach, one built from plywood and one from a cardboard box',
}

const {
    title,
    description = DEFAULT_DESCRIPTION,
    noindex = isNoindex(Astro.url.pathname),
} = Astro.props

// Titles that already say "Ro/Box" don't need it twice.
const pageTitle = title.includes(SITE_NAME)
    ? title
    : `${title} | ${SITE_NAME}`

const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImageUrl = new URL(OG_IMAGE.path, Astro.site)
---

<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- PNG fallback for browsers that don't take an SVG favicon; they pick the
     best `icon` they understand, so this only gets used where it's needed. -->
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png" />
<!-- iOS home screen. Kept at the conventional root filename, which is also
     where Safari looks when a page declares no icon at all. -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<!-- Android home screen; the 192 and 512 icons are declared in here. -->
<link rel="manifest" href="/site.webmanifest" />

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta
    name="keywords"
    content="Robox, Ro/Box, robotics, Python, line following, line-following, Rise Project, low-cost robotics, cheap robotics kit, robotics kit, RCJA, RoboCup, RoboCupJunior, RoboCup Junior Australia, STEM kit, STEM"
/>
<meta name="author" content="Ro/Box" />
<meta name="copyright" content="All content copyright © 2025 Ro/Box" />
<meta name="theme-color" content="#F8F8F8" />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_AU" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:secure_url" content={ogImageUrl.href} />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE.height)} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={OG_IMAGE.alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="twitter:image:alt" content={OG_IMAGE.alt} />
