---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faCircleCheck } from '@fortawesome/free-solid-svg-icons';

interface Props {
    /** Must match the `namespace` passed to `createStageFlow` for the same flow. */
    namespace: string
    stages: readonly string[]
    stageLabels: Record<string, string>
}

const { namespace, stages, stageLabels } = Astro.props
---
<ol class="stageStepper flex items-center gap-2" data-namespace={namespace}>
    {stages.map((stage, index) => (
        <>
            <li class="stageStep flex shrink-0 items-center gap-2" data-stage={stage}>
                <div class="stageStepCircle relative flex size-8 shrink-0 items-center justify-center rounded-full bg-gray-300 font-bold text-white transition-colors duration-300">
                    <span class="stageStepNumber absolute inset-0 flex scale-100 items-center justify-center opacity-100 transition-[opacity,scale] duration-200 ease-out">
                        {index + 1}
                    </span>
                    {/* Wrapping span so the colour can be forced past the global base-layer `span` rule. */}
                    <span class="stageStepCheck absolute inset-0 flex scale-75 items-center justify-center text-white! opacity-0 transition-[opacity,scale] duration-200 ease-out">
                        <FontAwesomeIcon icon={faCircleCheck} />
                    </span>
                </div>
                <span class="stageStepLabel text-sm font-semibold text-gray-400 transition-colors duration-300">{stageLabels[stage]}</span>
            </li>
            {index < stages.length - 1 && (
                // A separate fill layer scales in from the left, rather than the track flipping colour.
                <li class="stageStepConnector relative h-0.5 flex-1 overflow-hidden bg-gray-300" aria-hidden="true">
                    <div class="stageStepConnectorFill absolute inset-0 origin-left scale-x-0 bg-green transition-transform duration-500 ease-out"></div>
                </li>
            )}
        </>
    ))}
</ol>
<script>
    // Astro includes this script once however many steppers render, so wire up every instance.
    document.querySelectorAll<HTMLOListElement>(".stageStepper").forEach((stepper) => {
        const namespace = stepper.dataset.namespace
        if (!namespace) throw new Error("Stage stepper missing its namespace");

        const steps = stepper.querySelectorAll<HTMLLIElement>(":scope > .stageStep");
        const connectors = stepper.querySelectorAll<HTMLLIElement>(":scope > .stageStepConnector");
        // The orchestrator dispatches on its own root rather than bubbling,
        // since it needs to reach a descendant instead of an ancestor.
        const root = stepper.closest<HTMLElement>("[data-stage-flow-root]");
        if (!root) throw new Error("Stage stepper must be nested inside a [data-stage-flow-root] element");

        function setIconVisible(icon: HTMLElement, visible: boolean) {
            icon.classList.toggle("opacity-100", visible);
            icon.classList.toggle("scale-100", visible);
            icon.classList.toggle("opacity-0", !visible);
            icon.classList.toggle("scale-75", !visible);
        }

        function highlight(stage: string) {
            const activeIndex = [...steps].findIndex((step) => step.dataset.stage === stage);
            steps.forEach((step, index) => {
                const circle = step.querySelector<HTMLDivElement>(".stageStepCircle");
                const number = step.querySelector<HTMLElement>(".stageStepNumber");
                const check = step.querySelector<HTMLElement>(".stageStepCheck");
                const label = step.querySelector<HTMLSpanElement>(".stageStepLabel");
                if (!circle || !number || !check || !label) return;

                circle.classList.remove("bg-gray-300", "bg-blue", "bg-green");
                circle.classList.add(
                    index < activeIndex ? "bg-green" : index === activeIndex ? "bg-blue" : "bg-gray-300",
                );
                label.classList.toggle("text-black", index <= activeIndex);
                label.classList.toggle("text-gray-400", index > activeIndex);

                const completed = index < activeIndex;
                setIconVisible(check, completed);
                setIconVisible(number, !completed);
                // `!important`, because the global base-layer `span` rule forces this dark.
                number.classList.toggle("text-white!", index === activeIndex);
                number.classList.toggle("text-gray-400!", index !== activeIndex);
            });
            connectors.forEach((connector, index) => {
                const fill = connector.querySelector<HTMLDivElement>(".stageStepConnectorFill");
                fill?.classList.toggle("scale-x-100", index < activeIndex);
                fill?.classList.toggle("scale-x-0", index >= activeIndex);
            });
        }

        root.addEventListener(`${namespace}:stage-changed`, (event) => {
            highlight((event as CustomEvent<{ stage: string }>).detail.stage);
        });

        const firstStage = steps[0]?.dataset.stage;
        if (firstStage) highlight(firstStage);
    });
</script>
