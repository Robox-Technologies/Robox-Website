---
import { faUsb, faBluetoothB } from "@fortawesome/free-brands-svg-icons";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
---
<div class="communicationMethodToggle" data-method="USB">
    <button
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Connect over Bluetooth instead of USB"
        title="Connecting over USB — click to switch to Bluetooth"
        class="communicationMethodToggleSwitch button-interactive relative flex items-center w-20 h-10 rounded-full border-2 border-blue bg-white box-shadow pointer-events-auto"
    >
        <span class="communicationMethodToggleKnob absolute top-0.5 left-0.5 w-8 h-8 rounded-full bg-blue"></span>
        {/* 1.5px left of the knob: the glyph's solid square branch makes it read right-heavy. */}
        <span class="communicationMethodToggleIcon communicationMethodToggleUsb absolute top-0.5 left-[1.5px] flex w-8 h-8 items-center justify-center">
            <FontAwesomeIcon icon={faUsb} className="text-lg -rotate-90" />
        </span>
        <span class="communicationMethodToggleIcon communicationMethodToggleBluetooth absolute top-0.5 left-[42px] flex w-8 h-8 items-center justify-center">
            <FontAwesomeIcon icon={faBluetoothB} className="text-lg" />
        </span>
    </button>
</div>
<style>
    .communicationMethodToggleKnob {
        transition: transform 200ms ease-out;
    }
    /* Knob is 2rem inside a 5rem pill with a 2px border and 2px inset. */
    .communicationMethodToggle[data-method='WebBluetooth'] .communicationMethodToggleKnob {
        transform: translateX(calc(5rem - 2rem - 8px));
    }

    /* global.css colours every span dark, so the icons set their own colour. */
    .communicationMethodToggleIcon {
        color: var(--color-blue);
        transition: color 200ms ease-out;
    }
    .communicationMethodToggle[data-method='USB'] .communicationMethodToggleUsb,
    .communicationMethodToggle[data-method='WebBluetooth'] .communicationMethodToggleBluetooth {
        color: #ffffff;
    }

    .communicationMethodToggleSwitch:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }
    .communicationMethodToggle[data-unsupported] .communicationMethodToggleIcon {
        color: var(--color-gray-500, #6b7280);
    }
    .communicationMethodToggle[data-unsupported] .communicationMethodToggleKnob {
        display: none;
    }
</style>
<script>
    // Astro includes this script once, but both editor bodies render a copy of the
    // component, so wire up every instance.
    import { pico } from "@/libs/communication/communicate";
    import { toast } from "@/libs/ui/toast";
    import {
        getPreferredCommunicationMethod,
        setPreferredCommunicationMethod,
    } from "@/libs/communication/communicationMethodStorage";
    import type { CommunicationMethod, PicoState } from "src/types/communication";
    import { ConnectionStatus } from "src/types/communication";

    const methodLabels: Partial<Record<NonNullable<CommunicationMethod>, string>> = {
        USB: "USB",
        WebBluetooth: "Bluetooth",
    };

    // Web Serial and Web Bluetooth can each be missing independently, so only cycle
    // through the ones this browser exposes.
    const supportsUsb = "serial" in navigator;
    const supportsWebBluetooth = "bluetooth" in navigator;
    const supportedMethods = [
        ...(supportsUsb ? (["USB"] as const) : []),
        ...(supportsWebBluetooth ? (["WebBluetooth"] as const) : []),
    ];

    const preferred = getPreferredCommunicationMethod();
    const initial =
        preferred && supportedMethods.includes(preferred as never)
            ? preferred
            : (supportedMethods[0] ?? null);

    // Set the shared connection's method exactly once, regardless of how
    // many toggle instances are on the page.
    if (initial) void pico.setCommunicationMethod(initial);

    // Synchronous, because `pico.getState()` still reports the old method until
    // `setCommunicationMethod` settles.
    function cycle(): CommunicationMethod {
        const current = pico.getState().communicationMethod;
        if (supportedMethods.length < 2) return current;
        const currentIndex = supportedMethods.indexOf(current as never);
        const next =
            supportedMethods[(currentIndex + 1) % supportedMethods.length];
        setPreferredCommunicationMethod(next);
        void pico.setCommunicationMethod(next);
        return next;
    }

    const roots = document.querySelectorAll<HTMLDivElement>(".communicationMethodToggle");

    // Every instance mirrors the one shared method, so a switch in one updates all.
    function showMethod(method: CommunicationMethod) {
        const bluetooth = method === "WebBluetooth";
        const label = methodLabels[method ?? "USB"] ?? "USB";
        const other = bluetooth ? "USB" : "Bluetooth";
        roots.forEach((root) => {
            const button = root.querySelector<HTMLButtonElement>("button")!;
            root.dataset.method = bluetooth ? "WebBluetooth" : "USB";
            button.setAttribute("aria-checked", bluetooth ? "true" : "false");
            if (supportedMethods.length < 2) {
                button.title = `Connecting over ${label} — this browser doesn't support ${other}`;
                return;
            }
            button.title = `Connecting over ${label} — click to switch to ${other}`;
        });
    }

    roots.forEach((root) => {
        const button = root.querySelector<HTMLButtonElement>("button");
        if (!button) throw new Error("Communication method toggle button not found");

        if (!initial) {
            button.disabled = true;
            button.title = "Your browser doesn't support connecting to a Ro/Box";
            root.dataset.unsupported = "";
            return;
        }

        // Nothing to switch to when only one method is available.
        if (supportedMethods.length < 2) button.disabled = true;

        button.addEventListener("click", () => {
            showMethod(cycle());
        });

        // Locked while CONNECTING, so a switch can't abandon a connect in progress.
        if (supportedMethods.length > 1) {
            pico.on("stateChange", (state: PicoState) => {
                button.disabled =
                    state.connectionStatus === ConnectionStatus.CONNECTING;
            });
        }
    });

    if (initial) showMethod(initial);
</script>
