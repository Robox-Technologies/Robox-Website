---
import PageHero from '@/components/pageHero';
import StandardLayout from '@/layouts/StandardLayout.astro';
import Hero from '@/images/studentHub/hero.jpg';
import AppHero from '@/features/studentHub/appHero/appHero.astro';
import Article from '@/components/article/Article';
import StudentResources from '@/features/studentHub/studentResources/studentResources.astro';
import StudentProjects from '@/features/studentHub/studentProjects/studentProjects.astro';
import { Image } from 'astro:assets';
const isIOSBuild = process.env.IOS_BUILD === 'true';
---
<StandardLayout
    title="Ro/Box Hub"
    description="Step-by-step assembly guides, coding lessons, and a free block code editor for your Ro/Box."
    header="workshop"
>
    {isIOSBuild ?
        <AppHero>
            <h1 class="text-5xl font-bold text-primary">
                Welcome to our Mobile app!
            </h1>
            <p class="text-xl text-primary mt-8">
                Support for this app is done separately to our website.<br>
                If you encounter any bugs/issues, reach out to us at <a href="mailto:hello@robox.com.au" class="text-primary">hello@robox.com.au</a>.
            </p>
        </AppHero>
        :
        <PageHero gradient='positive' className='bg-black' lineWidth='20px' overlap='10vw'>
            <div slot="left" class="bg-yellow h-full w-full flex justify-start items-end p-8">
                <h1 class="text-5xl font-bold">
                    Ro/Box Hub
                </h1>
            </div>
            <div slot="right" class="bg-primary h-full">
                <!-- The right panel of PageHero is ~72vw wide on desktop and
                     full-width on mobile, so a single fixed render is either
                     blurry on a large screen or oversized on a phone. `widths`
                     + `sizes` let the browser pick; 2560 covers a 1440pt panel
                     at 2x DPR, which is where the source (8256x5504) stops
                     buying any visible detail. -->
                <Image
                    src={Hero}
                    alt="A Ro/Box next to an open laptop showing a forest scene"
                    class="w-full h-full object-cover object-left"
                    widths={[640, 960, 1280, 1920, 2560]}
                    sizes="(min-width: 768px) 75vw, 100vw"
                    width={2560}
                    height={1707}
                    loading="eager"
                    fetchpriority="high"
                />
            </div>
        </PageHero>
    }
    <Article>
        {!isIOSBuild && <StudentResources />}
        <StudentProjects  />
    </Article>
</StandardLayout>