---
import EditorLayout from "@/layouts/EditorLayout.astro";
import ProjectHeader from "@/features/editor/components/header/projectHeader.astro";
import EditorBody from "@/features/editor/components/editorBody.astro";
---
<style>
    html, body {
        height: 100%;
        width: 100%;
    }
</style>
<EditorLayout
    title="Ro/Box Editor"
    description="Program your Ro/Box in the browser with our beginner-friendly block code editor. Nothing to install."
>

    <div class="w-full h-full flex flex-col">
        <ProjectHeader />
        <EditorBody />

    </div>
</EditorLayout>