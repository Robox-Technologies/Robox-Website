---
import EditorLayout from "@/layouts/EditorLayout.astro";
import ProjectHeader from "@/features/blockEditor/components/editor/projectHeader.astro";
import BlocklyEditor from "@/features/blockEditor/components/editor.astro";
---
<style>
    html, body {
        height: 100%;
        width: 100%;
    }
</style>
<EditorLayout
    title="Ro/Box Editor"
    description="Program your Ro/Box in the browser with our beginner-friendly block code editor. Nothing to install."
    noindex>

    <div class="w-full h-full flex flex-col">
        <ProjectHeader />
        <BlocklyEditor />

    </div>
</EditorLayout>