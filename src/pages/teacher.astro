---
import PageHero from '@/components/pageHero';
import StandardLayout from '../layouts/StandardLayout.astro';
import Hero from '@/images/teacherHub/hero.jpg';
import Article from '@/components/article/Article';
import eyes from '@/images/goobers/eyes.svg';
import ResourceCard from '@/components/cms/ResourceCard.astro';
import { getCMSContentFor } from '@/utils/server/cms.server';
import { Image } from 'astro:assets';

const lessonPlans = await getCMSContentFor('Teacher Resources');
---
<StandardLayout
    title="Teacher Resources"
    description="Free lesson plans, curriculums, and classroom-ready resources for teaching robotics and coding with Ro/Box."
>
    <PageHero gradient='positive' className='bg-black' leftWidth='66%' lineWidth='20px' overlap='10vw'>
        <div slot="left" class="bg-primary h-full">
            <div class="h-full w-full flex justify-start items-end p-8">
                <!-- Above the hero photo that follows it in the markup, but
                     below the header's z-50: z-100 put the title on top of the
                     open mobile menu. -->
                <h1 class="relative z-10 text-5xl font-bold" >
                    Teacher Resources
                </h1>

            </div>
            <!-- The left panel is ~71vw wide on desktop (66% - 20px/2 + 10vw/2,
                 see pageHero) and full-width on mobile, so a single fixed
                 render is either blurry on a large screen or oversized on a
                 phone. `widths` + `sizes` let the browser pick. The 85vw hint
                 is the panel width plus headroom: the source is 3.06:1 against
                 a 400px-tall panel, so object-cover crops horizontally and
                 paints ~1.2x wider than the panel is. -->
            <Image
                src={Hero}
                alt=""
                aria-hidden="true"
                class="w-full absolute top-0 h-full object-cover object-left"
                widths={[640, 960, 1280, 1920, 2560]}
                sizes="(min-width: 768px) 85vw, 100vw"
                width={2560}
                height={837}
                loading="eager"
                fetchpriority="high"
            />
        </div>
        <div slot="right" class="bg-yellow h-full w-full relative overflow-hidden">
            <img
                src={eyes.src}
                alt=""
                aria-hidden="true"
                class="eyes absolute top-8 right-8 w-[195px] max-w-[45%]"
            />
        </div>
    </PageHero>
    <Article>
        <h1 class="text-5xl font-bold mb-8">
            Lesson Plans
        </h1>
        {
            lessonPlans.length > 0 ? (
                <div class="card-holder flex w-full flex-wrap items-stretch gap-8">
                    {lessonPlans.map((item) => (
                        <ResourceCard item={item} />
                    ))}
                </div>
            ) : (
                <p class="text-lg text-tone3">
                    Lesson plans are on their way! Check back soon.
                </p>
            )
        }
    </Article>
</StandardLayout>