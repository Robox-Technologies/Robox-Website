---
import PageHero from '@/components/pageHero';
import StandardLayout from '../layouts/StandardLayout.astro';
import Hero from '@/images/teacherHub/hero.jpg';
import Article from '@/components/article/Article';
import eyes from '@/images/goobers/eyes.svg';
import ResourceCard from '@/components/cms/ResourceCard.astro';
import { getCMSContentFor } from '@/utils/server/cms.server';

const lessonPlans = await getCMSContentFor('Teacher Resources');
---
<StandardLayout
    title="Teacher Resources"
    description="Free lesson plans, curriculums, and classroom-ready resources for teaching robotics and coding with Ro/Box. No robotics experience needed."
>
    <PageHero gradient='positive' className='bg-black' leftWidth='66%' lineWidth='20px' overlap='10vw'>
        <div slot="left" class="bg-primary h-full">
            <div class="h-full w-full flex justify-start items-end p-8">
                <h1 class="relative z-100 text-5xl font-bold" >
                    Teacher Resources
                </h1>

            </div>
            <img src={Hero.src} alt="" aria-hidden="true" class="w-full absolute top-0 h-full object-cover object-left"/>
        </div>
        <div slot="right" class="bg-yellow h-full w-full relative overflow-hidden">
            <img
                src={eyes.src}
                alt=""
                aria-hidden="true"
                class="eyes absolute top-8 right-8 w-[195px] max-w-[45%]"
            />
        </div>
    </PageHero>
    <Article>
        <h1 class="text-5xl font-bold mb-8">
            Lesson Plans
        </h1>
        {
            lessonPlans.length > 0 ? (
                <div class="card-holder flex w-full flex-wrap items-stretch gap-8">
                    {lessonPlans.map((item) => (
                        <ResourceCard item={item} />
                    ))}
                </div>
            ) : (
                <p class="text-lg text-tone3">
                    Lesson plans are on their way! Check back soon.
                </p>
            )
        }
    </Article>
</StandardLayout>