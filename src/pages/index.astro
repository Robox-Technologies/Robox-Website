---
import StandardLayout from '@/layouts/StandardLayout.astro'

import Hero from '@/components/Hero.astro'

import ArticleSection from '@/components/article/ArticleSection'
import ArticleText from '@/components/article/ArticleText'
import Article from '@/components/article/Article'
import Button from '@/components/button'
import hero from '@/images/index/hero.png'
import heroMobile from '@/images/index/hero-mobile.png'
import { Image } from 'astro:assets'
import article1 from '@/images/index/article1.png'
import article2 from '@/images/index/article2.png'
import article3 from '@/images/index/article3.png'
import Goober from '@/components/Goober.astro'
import star from '@/images/goobers/star.svg'
import square from '@/images/goobers/square.svg'

// import roboxHubCard1 from '@/images/index/roboxHubCard1.png'
// import roboxHubCard2 from '@/images/index/roboxHubCard2.png'
// import roboxHubCard3 from '@/images/index/roboxHubCard3.png'

import BoxToBot from '@/features/home/boxToBot/components/boxToBot.astro'

import EmpoweringStudents from '@/features/home/empoweringStudents/empoweringStudents.astro'
import CheckOutOurKits from '@/features/home/checkOutOurKits/checkOutOurKits.astro'
---
<StandardLayout title="Home">
    <Hero
        hero={hero}
        heroMobile={heroMobile}
        alt="A Ro/Box robot assembled from plywood and standing on a rock at the beach"
        scrollIndicator={true}
        imageClass="lg:object-[30%_center]"
    >
        <div class="flex flex-col items-center absolute lg:right-1/10 lg:top-1/2 top-1/5 transform -translate-y-1/2">
            <h1 class="text-6xl w-full font-bolder mb-4 text-blue text-center">
                Robotics<br/>
                <span class="text-red text-5xl">
                    for everyone
                </span>
            </h1>
        </div>
    </Hero>
    <Article>
        <ArticleSection id="content" direction="LTR">
            <ArticleText>
                <h1 class=" text-6xl">Meet Ro/Box</h1>
                <p class="text-xl leading-[150%]">
                    Ro/Box is an ultra-affordable robotics kit designed to make STEM education accessible to any student, anywhere. Whether you're a budding engineer or a curious coder, Ro/Box offers hands-on experience in building, programming, and problem-solving.
                </p>
                <Button href="/about" className='bg-red px-6 py-4 text-3xl box-shadow w-fit'>
                    About us
                </Button>
            </ArticleText>
            <Image src={article1} alt="Robox Kit Components" class="rounded-lg max-w-full max-h-full w-1/2 lg:w-3/10"/>
        </ArticleSection>
        <ArticleSection id="moto" direction="RTL" className="relative isolate">
            <Goober shape={star} class="left-[15%] top-[max(-35%,-150px)] w-[290px] max-[1000px]:hidden" />
            <ArticleText className="lg:w-1/2 w-full">
                <h1 class=" text-6xl">Build it. Code it. Bring it to life.</h1>
                <p class="text-xl leading-[150%]">
                    There is more to Ro/Box than meets the eye. Each kit is jam-packed with features <span class="italic">(as much as our budget allows)</span> to give you the most value out of an already affordable product.
                </p>
                <ul class="list-disc list-inside flex flex-col gap-2 mt-4">
                    <li class="text-xl"><span class="font-bold">Plywood chassis:</span> We use sustainable material that looks both elegant and strong to create the box shape. (After all, it wouldn't be Ro/Box without Box!)</li>
                    <li class="text-xl"><span>Reusable components:</span> No proprietary hardware! All of the components within a Ro/Box kit can be modified, substituted, or used in other robotics projects.</li>
                    <li class="text-xl"><span class="font-bold">Open-sourced:</span> We mean it. Everything from the Ro/Box design schematics, to this website, is open-sourced. It's our way of giving to the community.</li>
                </ul>
            </ArticleText>
            <Image src={article2} alt="Robox Kit Components" class="rounded-lg max-w-full max-h-full w-full lg:w-1/2 object-contain"/>
        </ArticleSection>
    </Article>
    <BoxToBot />
    <EmpoweringStudents />
    <Article>
        <ArticleSection id="teacher-hub" direction="RTL" className="relative">
            <Goober
                shape={square}
                eyes
                class="bottom-[-32px] right-0 w-[150px] max-[1000px]:hidden"
                eyesClass="top-[20%] left-[20%] w-[103px]"
            />
            <ArticleText className="lg:w-1/2 w-full">
                <h1 class=" text-6xl">Teacher Hub</h1>
                <p class="text-xl leading-[150%]">
                    We know that great learning starts with confident teaching. That's why we've built a dedicated Teacher Hub filled with classroom-ready resources—lesson plans, curriculums, and more.
                </p>
                <Button href="/teacher" className='bg-red px-6 py-4 text-2xl box-shadow w-fit'>
                    Visit Teacher Hub
                </Button>
            </ArticleText>
            <Image src={article3} alt="A nearly assembled Ro/Box kit with its lid open" class="rounded-lg max-w-full max-h-full w-full lg:w-1/2 object-contain"/>
        </ArticleSection>
    </Article>
    <CheckOutOurKits />
</StandardLayout>
