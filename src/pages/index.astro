---
import image from '@images/index/hero.jpg' 
import Hero from '@components/Hero'
import StandardLayout from '@layouts/StandardLayout.astro'
import ArticleSection from '@components/article/ArticleSection'
import ArticleText from '@components/article/ArticleText'
import Article from '@components/article/Article'
---
<!-- TODO: Make the image work like the normal website, and make the title work better -->
<StandardLayout title="Home">
    <Hero hero={image} scrollIndicator={true}>
        <div class="flex flex-col items-center absolute lg:right-2/10 lg:top-1/2 top-1/10 transform -translate-y-1/2">
            <h1 class="text-5xl w-full font-bold mb-4 text-blue text-left">
                Robotics for
            </h1>
            <h1 class="text-5xl w-full font-bold text-red text-left">
                Everyone
            </h1>
        </div>
    </Hero>
    <Article>
        <ArticleSection id="meet-robox" direction="LTR">
            <ArticleText>
                <h1 class="mb-4 text-6xl">Meet Robox</h1>
                <p class="mb-4 text-xl leading-[150%]">
                    Ro/Box is an ultra-affordable robotics kit designed to make STEM education accessible to any student, anywhere. Whether you’re a budding engineer or a curious coder, Ro/Box offers hands-on experience in building, programming, and problem-solving
                </p>
            </ArticleText>
        </ArticleSection>
    </Article>
</StandardLayout>
