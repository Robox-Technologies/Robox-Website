---
import { getAllProducts } from '@/utils/server/stripe.server'
import type { ImageMetadata } from 'astro'
import StandardLayout from '@/layouts/StandardLayout.astro'
import Article from '@/components/article/Article'
import CartView from '@/features/shop/cart/components/cartView'

const products = await getAllProducts()
const images = import.meta.glob<{ default: ImageMetadata }>(
    'src/images/shop/products/*/thumbnail.jpg',
    { eager: true },
)

const imageSrcById = products.reduce(
    (acc, product) => {
        const imagePath = `/src/images/shop/products/${product.internalName}/thumbnail.jpg`
        if (!images[imagePath]) {
            throw new Error(
                `Missing image for product ${product.name} at path ${imagePath} only found: ${Object.keys(images).join(', ')}`,
            )
        }

        acc[product.internalName] = images[imagePath].default.src
        return acc
    },
    {} as Record<string, string>,
)
---
<StandardLayout title="Cart">
    <Article className="w-full px-6! py-6! lg:flex lg:h-[calc(100vh-8rem)] lg:flex-col lg:px-8!">
        <a
            href="/shop"
            class="mb-4 inline-flex items-center text-base font-semibold text-blue hover:underline"
        >
            ← Shop
        </a>
        <h1 class="mb-8 text-5xl font-bold">My Cart</h1>

        <div class="min-h-0 flex-1">
            <CartView products={products} imageSrcById={imageSrcById} client:only="react">
                <div slot="fallback" class="flex h-full flex-col gap-8 lg:flex-row lg:items-stretch">
                    <div class="flex w-full flex-1 flex-col gap-6 rounded-xl border border-black/10 bg-white p-6 shadow-sm lg:h-full lg:overflow-y-auto">
                        <div class="flex min-h-72 flex-col items-center justify-center gap-3 text-center">
                            <h2 class="mb-0! text-3xl font-bold">
                                Loading cart...
                            </h2>
                        </div>
                    </div>

                    <div class="w-full lg:h-full lg:w-96 lg:shrink-0">
                        <aside class="flex h-full flex-col rounded-xl border border-black/10 bg-white p-6 shadow-sm">
                            <h2 class="mb-4! text-2xl font-bold">Order Summary</h2>
                            <p class="mb-0 text-gray-600">
                                Add products to build your checkout summary.
                            </p>
                        </aside>
                    </div>
                </div>
            </CartView>
        </div>
    </Article>
</StandardLayout>