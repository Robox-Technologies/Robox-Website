---
import { getAllProducts } from '@/utils/server/stripe/getAllProducts.server'
import type { ImageMetadata } from 'astro'
import StandardLayout from '@/layouts/StandardLayout.astro'
import Article from '@/components/article/Article'
import CartView from '@/features/shop/cart/components/cartView'

const products = await getAllProducts()
const images = import.meta.glob<{ default: ImageMetadata }>(
    'src/images/shop/products/*/thumbnail.jpg',
    { eager: true },
)

const imageSrcById = products.reduce(
    (acc, product) => {
        const imagePath = `/src/images/shop/products/${product.internalName}/thumbnail.jpg`
        if (!images[imagePath]) {
            throw new Error(
                `Missing image for product ${product.name} at path ${imagePath} only found: ${Object.keys(images).join(', ')}`,
            )
        }

        acc[product.internalName] = images[imagePath].default.src
        return acc
    },
    {} as Record<string, string>,
)
---
<StandardLayout
    title="Cart"
    description="Review the Ro/Box kits in your cart before you check out."
>
    <!-- Flows down the page: no viewport-height shell, no inner scroll area. -->
    <Article className="p-16 max-[1000px]:p-8">
        <a href="/shop" class="text-lg leading-[64px] hover:underline">
            &lsaquo;&nbsp;Shop
        </a>
        <h1 class="mb-8">My Cart</h1>

        <CartView products={products} imageSrcById={imageSrcById} client:only="react">
            <div slot="fallback" class="flex flex-col gap-[50px] min-[900px]:flex-row min-[900px]:items-start">
                <div class="flex w-full flex-1 flex-col">
                    <h2 class="my-[20.75px] text-[25px] font-medium">Loading cart...</h2>
                </div>

                <!-- Mirrors SummaryCard's own wrapper so hydration doesn't move it. -->
                <div class="w-full min-[900px]:w-96 min-[900px]:shrink-0">
                    <aside class="flex flex-col rounded-xl border border-black/10 bg-white p-6 shadow-sm">
                        <h2 class="mb-4! text-2xl font-bold">Order Summary</h2>
                        <p class="mb-0 text-gray-600">
                            Add products to build your checkout summary.
                        </p>
                    </aside>
                </div>
            </div>
        </CartView>
    </Article>
</StandardLayout>