---
import StandardLayout from '@/layouts/StandardLayout.astro'
import background from '@/images/shop/confirmation/background.svg'
import { faCircleExclamation } from '@fortawesome/free-solid-svg-icons'
import {
    faInstagram,
    faLinkedinIn,
    faXTwitter,
} from '@fortawesome/free-brands-svg-icons'

/** Pull the raw path out of a FontAwesome icon so it can be inlined here. */
function iconPath(icon: typeof faCircleExclamation) {
    const [width, height, , , path] = icon.icon
    return {
        viewBox: `0 0 ${width} ${height}`,
        d: Array.isArray(path) ? path.join(' ') : path,
    }
}

const alertIcon = iconPath(faCircleExclamation)
const socials = [
    {
        href: 'https://www.instagram.com/robox.kit',
        label: 'Instagram',
        icon: iconPath(faInstagram),
    },
    {
        href: 'https://x.com/robox_kit',
        label: 'X/Twitter',
        icon: iconPath(faXTwitter),
    },
    {
        href: 'https://www.linkedin.com/company/roboxeducation',
        label: 'LinkedIn',
        icon: iconPath(faLinkedinIn),
    },
]
---

<StandardLayout
    title="Order Confirmation"
    description="The status of your Ro/Box order."
>
    <div
        class="flex min-h-[80vh] items-center justify-center bg-blue bg-cover bg-no-repeat p-16 max-[1000px]:p-8"
        style={`background-image: url(${background.src})`}
    >
        <div
            class="result-card w-full max-w-[800px] rounded-[20px] bg-primary p-8 text-center"
        >
            <div id="status-loading">
                <div class="load-spinner mx-auto"></div>
                <h1>Processing payment...</h1>
                <h2 class="status-body">
                    Sit tight! We're just processing your payment.<br />
                    This may take a moment.
                </h2>
            </div>

            <div id="status-failure" hidden>
                <svg
                    class="mx-auto mb-4 h-12 w-12 text-black"
                    viewBox={alertIcon.viewBox}
                    aria-hidden="true"
                >
                    <path d={alertIcon.d} fill="currentColor"></path>
                </svg>
                <h1>Payment failed</h1>
                <h2 class="status-body">
                    Something went wrong with your payment. Don't worry—you can
                    try again or update your payment info.
                </h2>
                <a href="/shop/cart" class="button-interactive cta-button">
                    Back to cart
                </a>
            </div>

            <div id="status-success" hidden>
                <h1>Thank you!</h1>
                <h2 class="status-body">
                    Thank you for your purchase! We'll get started on your order
                    right away. <span id="status-email-sentence" hidden>You will receive a confirmation email shortly at <strong id="status-email"></strong>.</span>
                </h2>

                <div>
                    <p class="mb-0 text-lg text-tone3">Stay up to date with us!</p>
                    <hr class="my-2 h-0.5 border-0 bg-tone3" />
                    <div class="mt-4 flex justify-center gap-8">
                        {
                            socials.map((social) => (
                                <a
                                    href={social.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={social.label}
                                >
                                    <svg
                                        class="h-6 w-6 text-tone3"
                                        viewBox={social.icon.viewBox}
                                        aria-hidden="true"
                                    >
                                        <path
                                            d={social.icon.d}
                                            fill="currentColor"
                                        />
                                    </svg>
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</StandardLayout>

<style>
    /* The original's dropShadowLarge; the shared .box-shadow utility is the 6px
       variant used on buttons. */
    .result-card {
        box-shadow: 12px 12px 0 var(--color-drop-shadow);
    }

    /*
     * The original leaned on the browser's default heading margins (0.67em on
     * h1, 0.83em on h2) inside the card; Preflight zeroes those, so restate
     * them here to get the same vertical rhythm.
     */
    .result-card :global(h1) {
        margin: 0 0 0.67em;
    }

    .status-body {
        font-size: 25px;
        font-weight: 500;
        line-height: 1.4;
        margin: 0.83em 0;
    }

    .load-spinner {
        width: 60px;
        height: 60px;
        border: 8px solid #405c6430;
        border-top-color: var(--color-black);
        border-radius: 50%;
        animation: status-spin 2s linear infinite;
    }

    @keyframes status-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .load-spinner {
            animation-duration: 8s;
        }
    }
</style>

<script>
    import { actions } from 'astro:actions'
    import { clearCart } from '@/state/cartActions'

    const POLL_INTERVAL_MS = 1000
    /** Stop re-polling a still-processing order after a minute. */
    const MAX_POLLS = 60

    const panels = {
        loading: document.getElementById('status-loading'),
        failure: document.getElementById('status-failure'),
        success: document.getElementById('status-success'),
    }

    function show(state: keyof typeof panels) {
        for (const [name, panel] of Object.entries(panels)) {
            if (panel) panel.hidden = name !== state
        }
    }

    function showSuccess(email: string | null) {
        const sentence = document.getElementById('status-email-sentence')
        const target = document.getElementById('status-email')
        if (email && sentence && target) {
            target.textContent = email
            sentence.hidden = false
        }
        show('success')
        // The order is paid — the cart has served its purpose.
        clearCart()
    }

    function showFailure(reason: string) {
        console.warn(`Payment confirmation failed: ${reason}`)
        show('failure')
    }

    function sleep(ms: number) {
        return new Promise((resolve) => setTimeout(resolve, ms))
    }

    // Stripe substitutes the id into the `return_url` it was given when the
    // Checkout Session was created.
    const sessionId = new URL(window.location.href).searchParams.get('session_id')

    if (!sessionId) {
        showFailure('no checkout session id in the URL')
    } else {
        void (async () => {
            // Read on the server, and the email only comes back if the checkout cookie
            // owns this order.
            for (let attempt = 0; attempt < MAX_POLLS; attempt++) {
                const result = await actions.getCheckoutStatus({ sessionId })

                if (result.error) {
                    showFailure(result.error.message)
                    return
                }

                const { outcome, email } = result.data

                if (outcome === 'succeeded') {
                    showSuccess(email)
                    return
                }

                if (outcome === 'failed' || outcome === 'expired') {
                    showFailure(`checkout ${outcome}`)
                    return
                }

                await sleep(POLL_INTERVAL_MS)
            }

            // Still settling after the cap: the payment isn't lost, it's slow,
            // so say so rather than claiming failure.
            const body = document.querySelector('#status-loading .status-body')
            if (body) {
                body.textContent =
                    'This is taking longer than usual. No worries - your payment is still being processed and we\'ll email you as soon as it completes!'
            }
        })()
    }
</script>
