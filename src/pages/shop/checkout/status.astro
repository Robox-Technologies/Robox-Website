---
import StandardLayout from '@/layouts/StandardLayout.astro'
import background from '@/images/shop/confirmation/background.svg'
import { faCircleExclamation } from '@fortawesome/free-solid-svg-icons'
import {
    faInstagram,
    faLinkedinIn,
    faXTwitter,
} from '@fortawesome/free-brands-svg-icons'

/** Pull the raw path out of a FontAwesome icon so it can be inlined here. */
function iconPath(icon: typeof faCircleExclamation) {
    const [width, height, , , path] = icon.icon
    return {
        viewBox: `0 0 ${width} ${height}`,
        d: Array.isArray(path) ? path.join(' ') : path,
    }
}

const alertIcon = iconPath(faCircleExclamation)
const socials = [
    {
        href: 'https://www.instagram.com/robox.kit',
        label: 'Instagram',
        icon: iconPath(faInstagram),
    },
    {
        href: 'https://x.com/robox_kit',
        label: 'X/Twitter',
        icon: iconPath(faXTwitter),
    },
    {
        href: 'https://www.linkedin.com/company/roboxeducation',
        label: 'LinkedIn',
        icon: iconPath(faLinkedinIn),
    },
]
---

<StandardLayout title="Order Confirmation">
    <div
        class="flex min-h-[80vh] items-center justify-center bg-blue bg-cover bg-no-repeat p-8 md:p-16"
        style={`background-image: url(${background.src})`}
    >
        <div
            class="result-card w-full max-w-[800px] rounded-[20px] bg-primary p-8 text-center"
        >
            <div id="status-loading">
                <div class="load-spinner mx-auto"></div>
                <h1>Processing payment...</h1>
                <h2 class="status-body">
                    Sit tight! We're just processing your payment.<br />
                    This may take a moment.
                </h2>
            </div>

            <div id="status-failure" hidden>
                <svg
                    class="mx-auto mb-4 h-12 w-12 text-black"
                    viewBox={alertIcon.viewBox}
                    aria-hidden="true"
                >
                    <path d={alertIcon.d} fill="currentColor"></path>
                </svg>
                <h1>Payment failed</h1>
                <h2 class="status-body">
                    Something went wrong with your payment. Don't worry—you can
                    try again or update your payment info.
                </h2>
                <a
                    href="/shop/cart"
                    class="box-shadow mt-8 inline-block rounded-[20px] bg-red px-6 py-4 text-2xl font-semibold text-primary"
                >
                    Back to cart
                </a>
            </div>

            <div id="status-success" hidden>
                <h1>Thank you!</h1>
                <h2 class="status-body">
                    Thank you for your purchase! We'll get started on your order
                    right away.<span id="status-email-sentence" hidden
                        >&#32;You will receive a confirmation email shortly at <strong
                            id="status-email"></strong>.</span
                    >
                </h2>

                <div class="mt-8">
                    <p class="mb-0 text-tone3">Stay up to date with us!</p>
                    <hr class="my-4 h-px border-0 bg-tone3" />
                    <div class="flex justify-center gap-8">
                        {
                            socials.map((social) => (
                                <a
                                    href={social.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={social.label}
                                >
                                    <svg
                                        class="h-6 w-6 text-tone3"
                                        viewBox={social.icon.viewBox}
                                        aria-hidden="true"
                                    >
                                        <path
                                            d={social.icon.d}
                                            fill="currentColor"
                                        />
                                    </svg>
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</StandardLayout>

<style>
    /* The original's dropShadowLarge; the shared .box-shadow utility is the 6px
       variant used on buttons. */
    .result-card {
        box-shadow: 12px 12px 0 var(--color-drop-shadow);
    }

    .status-body {
        font-size: 25px;
        font-weight: 500;
        line-height: 1.4;
    }

    .load-spinner {
        width: 60px;
        height: 60px;
        border: 8px solid #405c6430;
        border-top-color: var(--color-black);
        border-radius: 50%;
        animation: status-spin 2s linear infinite;
    }

    @keyframes status-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .load-spinner {
            animation-duration: 8s;
        }
    }
</style>

<script>
    import { loadStripe } from '@stripe/stripe-js'
    import { clearCart } from '@/state/cartActions'

    const POLL_INTERVAL_MS = 1000
    /** Stop re-polling a stuck 'processing' intent after a minute. */
    const MAX_POLLS = 60

    const panels = {
        loading: document.getElementById('status-loading'),
        failure: document.getElementById('status-failure'),
        success: document.getElementById('status-success'),
    }

    function show(state: keyof typeof panels) {
        for (const [name, panel] of Object.entries(panels)) {
            if (panel) panel.hidden = name !== state
        }
    }

    function showSuccess(email: string | null) {
        const sentence = document.getElementById('status-email-sentence')
        const target = document.getElementById('status-email')
        if (email && sentence && target) {
            target.textContent = email
            sentence.hidden = false
        }
        show('success')
        // The order is paid — the cart has served its purpose.
        clearCart()
    }

    function showFailure(reason: string) {
        console.warn(`Payment confirmation failed: ${reason}`)
        show('failure')
    }

    function sleep(ms: number) {
        return new Promise((resolve) => setTimeout(resolve, ms))
    }

    const publishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY
    const clientSecret = new URL(window.location.href).searchParams.get(
        'payment_intent_client_secret',
    )

    if (!publishableKey) {
        showFailure('PUBLIC_STRIPE_PUBLISHABLE_KEY is not configured')
    } else if (!clientSecret) {
        showFailure('no payment intent client secret in the URL')
    } else {
        void (async () => {
            try {
                const stripe = await loadStripe(publishableKey)
                if (!stripe) {
                    showFailure('Stripe could not be initialised')
                    return
                }

                // Stripe can still be settling the payment when it redirects
                // here, so keep asking until it resolves either way.
                for (let attempt = 0; attempt < MAX_POLLS; attempt++) {
                    const { paymentIntent, error } =
                        await stripe.retrievePaymentIntent(clientSecret)

                    if (error) {
                        showFailure(error.message ?? 'unknown Stripe error')
                        return
                    }

                    if (
                        paymentIntent &&
                        paymentIntent.status !== 'processing'
                    ) {
                        if (paymentIntent.status === 'succeeded') {
                            showSuccess(paymentIntent.receipt_email)
                        } else {
                            showFailure(`intent status ${paymentIntent.status}`)
                        }
                        return
                    }

                    await sleep(POLL_INTERVAL_MS)
                }

                // Still processing after the cap: the payment isn't lost, it's
                // slow, so say so rather than claiming failure.
                const body = document.querySelector(
                    '#status-loading .status-body',
                )
                if (body) {
                    body.textContent =
                        'This is taking longer than usual. Your payment is still being processed — we'll email you as soon as it completes.'
                }
            } catch (error) {
                showFailure(String(error))
            }
        })()
    }
</script>
