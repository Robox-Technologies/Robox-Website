---
import type { GetStaticPaths } from 'astro'
import { getAllProducts } from '@/utils/server/stripe/getAllProducts.server'
import type { ImageMetadata } from 'astro'
import StandardLayout from '@/layouts/StandardLayout.astro'
import Article from '@/components/article/Article'
import Carousel from '@/features/catalog/components/Carousel'
import ProductCartModal from '@/components/shop/purchase/ProductCartModal'
import { formatStatus } from '@/features/catalog/utils/formatStatus'
import { formatPrice } from '@/utils/formatPrice'
import { toDescription } from '@/data/seo'

export const getStaticPaths = (async () => {
    const products = await getAllProducts()
    return products.map((product) => ({
        params: { id: product.internalName },
    }))
}) satisfies GetStaticPaths

const { id } = Astro.params
const products = await getAllProducts()

const product = products.find((p) => p.internalName === id)
if (!product) {
    throw new Error(`Product with id ${id} not found`)
}

const allImages = import.meta.glob<{ default: ImageMetadata }>(
    `src/images/shop/products/**/*`,
    { eager: true },
)

/**
 * Every product's photo set uses the same six filenames and, so far, the same
 * six shots, so the descriptions live here keyed by filename rather than being
 * repeated per product folder.
 */
const PHOTO_ALTS: Record<string, string> = {
    'thumbnail.jpg':
        'An assembled Ro/Box at a three-quarter angle, showing its plywood chassis and yellow wheels',
    'u1.jpg':
        'An assembled Ro/Box head on, its ultrasonic sensor looking straight down the lens',
    'u2.jpg':
        'An assembled Ro/Box from behind, with the battery pack and motor driver sitting in the open bay',
    'u3.jpg': 'A Ro/Box parked on a black line that runs across a white surface',
    'u4.jpg': 'A Ro/Box beside an open laptop showing the code that drives it',
    'u5.jpg':
        'Everything in the kit laid out flat: plywood panels, wheels, motors, sensors, battery pack, and jumper wires',
}

const images = Object.entries(allImages)
    .filter(([path]) => path.includes(`/src/images/shop/products/${product.internalName}/`))
    .map(([path, image]) => ({
        src: image.default,
        // Falls back to the product name so a newly added photo is never altless.
        alt: PHOTO_ALTS[path.split('/').pop() ?? ''] ?? product.name,
    }))
if (images.length === 0) {
    throw new Error(`Image for product ${product.internalName} not found`)
}

const descriptions = import.meta.glob<ExportedMarkdownModuleEntities>(
    '/src/data/products/*.mdx',
    { eager: true },
)
const description = descriptions[`/src/data/products/${product.internalName}.mdx`]
if (!description) {
    throw new Error(
        `Description for product ${product.internalName} not found at path /src/data/products/${product.internalName}.mdx, only found: ${Object.keys(descriptions).join(', ')}`,
    )
}

const statusText = formatStatus(product.status)
const priceText = formatPrice(product.price)

/**
 * The Stripe copy runs long for a search result, and its second half is the same
 * "designed as an engaging tool for teaching kids STEM..." clause on every
 * product. Keep the part that's actually about this kit, and close the sentence
 * that dropping the rest left hanging.
 */
const firstHalf = product.description.split('—')[0].trim()
const metaDescription = toDescription(
    /[.!?]$/.test(firstHalf) ? firstHalf : `${firstHalf}.`,
)
---
<StandardLayout title={product.name} description={metaDescription}>
    <!-- The original's --articleMargin: 64px, halved below 1000px. -->
    <Article className="p-16 max-[1000px]:p-8">
        <p class="my-4 text-base">
            <a href="/shop" class="underline opacity-80 hover:opacity-100">Shop all</a>
            &nbsp;/&nbsp;{product.name}
        </p>
        <div class="w-full flex flex-row max-[1250px]:flex-col gap-8">
            <Carousel images={images} client:load/>
            <!--
                Type scale and spacing mirror the original's `#important-info`:
                name and price are both heading-sized (49px), the price at
                regular weight in the body colour rather than a blue accent, and
                the copy below them at the 18px body size.
            -->
            <div class="flex-1 flex flex-col">
                {
                    /* Products can carry a promo line (the 10-Pack's "Save 5%"),
                       authored as HTML upstream in Stripe. */
                    product.banner && (
                        <div
                            class="product-banner mb-4 rounded-lg bg-green px-3 py-2"
                            set:html={product.banner}
                        />
                    )
                }
                <h1 class="text-[49px] leading-[1.25] font-extrabold">
                    {product.name}
                </h1>
                <p class="text-[49px] leading-[1.25] font-normal mb-8">
                    {priceText}
                </p>
                <p class="text-lg leading-[1.5] my-[18px]">
                    {product.description}
                </p>
                <p class={`${statusText.color} my-0`}>{statusText.text}</p>
                <div class="flex flex-col gap-4 w-50 mt-8">
                    <ProductCartModal product={product} image={images[0].src} client:only="react" />
                </div>
            </div>
        </div>
        <div class="markdown w-full mt-16 max-w-none">
            <description.Content />
        </div>
    </Article>
</StandardLayout>

<style>
    /* The banner is upstream HTML (a wrapped <p>), so strip its default margins
       the way the original's .product-banner did. */
    .product-banner :global(*) {
        margin: 0;
    }
</style>
