---
import { getAllProducts } from '@/utils/server/stripe/getAllProducts.server'
import StandardLayout from '@/layouts/StandardLayout.astro'
import Article from '@/components/article/Article'
import {
    CheckoutPaymentLoadingState,
    CheckoutSteps,
    CheckoutSummaryCard,
    CheckoutSummaryLoadingState,
} from '@/features/shop/checkout'

const products = await getAllProducts()
---
<StandardLayout
    title="Checkout"
    description="Enter your delivery and payment details to finish your Ro/Box order."
>
    <Article className="p-16 max-[1000px]:p-8">
        <a href="/shop/cart" class="text-lg leading-[64px] hover:underline">
            &lsaquo;&nbsp;Cart
        </a>
        <h1 class="mb-8">Checkout</h1>

        <!--
            `#main-content`: payment beside the summary, collapsing to
            column-reverse below 900px so the summary leads on narrow screens.
        -->
        <div class="flex flex-col-reverse gap-[50px] min-[900px]:flex-row min-[900px]:items-start">
            <CheckoutSteps products={products} client:only="react">
                <CheckoutPaymentLoadingState slot="fallback" />
            </CheckoutSteps>
            <CheckoutSummaryCard products={products} client:only="react">
                <CheckoutSummaryLoadingState slot="fallback" />
            </CheckoutSummaryCard>
        </div>
    </Article>
</StandardLayout>