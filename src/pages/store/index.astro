---
import { getAllProducts } from "@utils/server/stripe.server";
import type { ImageMetadata } from 'astro';
const products = await getAllProducts();
import { formatPrice } from "@utils/stripe";

import StandardLayout from "@layouts/StandardLayout.astro";
import PageHero from "@components/pageHero";

import Hero from "@images/shop/hero.jpg" ;
import { Image } from "astro:assets";
import Article from "@components/article/Article";
import ProductCard from "@components/store/productCard";
const images = import.meta.glob<{ default: ImageMetadata }>('src/images/shop/products/*/thumbnail.jpg', { eager: true });
// Check that all products have images
const product = {}
products.map(product => {
    const imagePath = `/src/images/shop/products/${product.internalName}/thumbnail.jpg`;
    if (!images[imagePath]) {
        throw new Error(`Missing image for product ${product.name} at path ${imagePath} only found: ${Object.keys(images).join(', ')}`);
    }
    return {
        ...product,
        image: images[imagePath]
    }
});
---
<StandardLayout title="Home">
    <PageHero gradient='negative' className='bg-black' lineWidth='20px' overlap='10vw'>
        <div slot="right" class="bg-primary h-full lg:">
            <Image src={Hero} alt="Student using Ro/Box" class="w-full h-full object-cover object-left" height={Hero.height} width={Hero.width}/>
        </div>
        <div slot="left" class="bg-blue h-full w-full flex justify-start items-end p-8">
            <h1 class="text-5xl font-bold text-white">
                Store
                <p class="text-xl mt-4 text-white">
                    Check out our Ro/Box product range!
                </p>
            </h1>
        </div>
    </PageHero>
    <Article>
        <h1 class="text-4xl font-bold mb-8">
            Our Products
        </h1>
        <div class="card-holder flex flex-wrap gap-4 w-full">
            {products.map(product => (
                <ProductCard
                    product={product}
                    image={images[`/src/images/shop/products/${product.internalName}/thumbnail.jpg`].default}
                    
                />
            ))}
        </div>
    </Article>
</StandardLayout>
