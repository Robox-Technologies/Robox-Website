---
import Meta from '@components/Meta'
import Header from '@components/header/Header'
import Footer from '@components/footer/footer'
import ToastHost from '@components/toast/ToastHost'

import '@styles/global.css'
interface Props {
    title: string
    header?: 'standard' | 'workshop';
};
const { title, header } = Astro.props as Props;
---
<html lang="en">
    <head>
        <Meta title={title} />
    </head>
    <body>
        <Header type={header ?? 'standard'} client:load />
        
        <slot />
        <ToastHost client:only="react" />
    </body>
    <Footer />
</html>