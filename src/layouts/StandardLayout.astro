---
import Meta from "../components/global/Meta";
import Header from "@components/global/header/Header";

type Props = {
    title: string;
    header?: "standard" | "workshop";
};
const { title, header } = Astro.props;
---
<html lang="en">
    <head>
        <Meta title={title} />
    </head>
    <body>
        <Header/>
        <slot />
    </body>
</html>