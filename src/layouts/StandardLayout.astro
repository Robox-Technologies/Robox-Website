---
import Meta from '@/components/Meta.astro'
import Analytics from '@/components/Analytics.astro'
import CookieConsent from '@/components/CookieConsent.astro'
import Header from '@/components/header/Header.astro'
import Footer from '@/components/footer/footer'
import { config } from '@fortawesome/fontawesome-svg-core'
import '@fortawesome/fontawesome-svg-core/styles.css';
import ToastHost from '@/components/toast/ToastHost'
import '@/styles/global.css'

config.autoAddCss = false
const isIOSBuild = process.env.IOS_BUILD === 'true';

interface Props {
    title: string
    /** Page description, for search results and social previews. */
    description?: string
    /** Keep this page out of search results. */
    noindex?: boolean
    header?: 'standard' | 'workshop';
};
const { title, description, noindex, header='standard' } = Astro.props as Props;
---
<html lang="en">
    <head>
        <Meta title={title} description={description} noindex={noindex} />
        <!-- Not in the iOS bundle: it's a Capacitor app, and neither the tag
             nor a cookie bar belongs in one. -->
        {!isIOSBuild && <Analytics />}
    </head>
    <body>
        {!isIOSBuild && <Header type={header} />}

        <slot />
        <ToastHost client:only="react" />
        <!-- Sits with the footer, which is where the original kept it. -->
        {!isIOSBuild && <CookieConsent />}
    </body>
    {!isIOSBuild && <Footer />}
</html>

<script>
    import { initEyes } from '@/utils/eyes'

    initEyes()
</script>
