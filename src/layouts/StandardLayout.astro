---
import Meta from "../components/Meta";
import Header from "@components/header/Header";
import "@styles/global.css";
interface Props {
    title: string;
    header?: "standard" | "workshop";
};
const { title, header } = Astro.props;
---
<html lang="en">
    
    <head>
        <Meta title={title} />
    </head>
    <body>
        <Header/>
        <slot />
    </body>
</html>