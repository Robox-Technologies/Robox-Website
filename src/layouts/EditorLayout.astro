---
import Meta from '@/components/Meta'
import Header from '@/components/header/Header.astro'

const isIOSBuild = process.env.IOS_BUILD === 'true';
import ToastHost from '@/components/toast/ToastHost'

// Manual fa css injection
import { config } from '@fortawesome/fontawesome-svg-core';
config.autoAddCss = false; 
import '@fortawesome/fontawesome-svg-core/styles.css';

import '@/styles/global.css'
interface Props {
    title: string
};
const { title } = Astro.props as Props;
---
<html lang="en">
    <head>
        <Meta title={title} />
        {/* iOS only: the native cross-document cross-fade hides the WKWebView
           white flash between pages. Web build has no view transition. Uses
           set:html so the raw CSS (with braces) isn't parsed as an expression. */}
        {isIOSBuild && (
            <style is:inline set:html="@view-transition { navigation: auto; }" />
        )}
    </head>
    <body class="flex flex-col">
        {!isIOSBuild && <Header type="workshop" />}
        
        <slot />
        <ToastHost client:only="react" />
    </body>
</html>