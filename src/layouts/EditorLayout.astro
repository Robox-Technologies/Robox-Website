---
import Meta from '@/components/Meta.astro'
import IOSAppReset from '@/components/IOSAppReset.astro'
import Analytics from '@/components/Analytics.astro'
import CookieConsent from '@/components/CookieConsent.astro'

const isIOSBuild = process.env.IOS_BUILD === 'true';
import ToastHost from '@/components/toast/ToastHost'

// Manual fa css injection
import { config } from '@fortawesome/fontawesome-svg-core';
config.autoAddCss = false; 
import '@fortawesome/fontawesome-svg-core/styles.css';

import '@/styles/global.css'
interface Props {
    title: string
    /** Page description, for search results and social previews. */
    description?: string
    /** Keep this page out of search results. */
    noindex?: boolean
};
const { title, description, noindex } = Astro.props as Props;
---
<html lang="en" data-ios-app={isIOSBuild || undefined}>
    <head>
        <Meta title={title} description={description} noindex={noindex} />
        {isIOSBuild && <IOSAppReset />}
        {/* Not in the iOS bundle: it's a Capacitor app, and neither the tag nor
             a cookie bar belongs in one. */}
        {!isIOSBuild && <Analytics />}
    </head>
    <body class="flex flex-col">

        <slot />
        <ToastHost client:only="react" />
        {/* Ships with Analytics, not the footer this layout doesn't have — consent
             defaults to denied, so there has to be a way to answer here. */}
        {!isIOSBuild && <CookieConsent />}
    </body>
</html>