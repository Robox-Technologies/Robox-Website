---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faPlug, faSpinner } from '@fortawesome/free-solid-svg-icons';
import Button from '@/components/button';
import CommunicationMethodToggle from '@/components/communicationMethodToggle.astro';

const isIOSBuild = process.env.IOS_BUILD === 'true';
---
<div
    class="controllerConnect flex flex-col gap-3"
    data-ios-build={isIOSBuild ? "true" : "false"}
>
    <p class="text-gray-800">
        Connect to your Ro/Box over USB or Bluetooth. Once it's connected, the
        Ro/Box switches into controller mode and stops any program it was running.
    </p>
    <div class="flex items-center gap-3">
        {!isIOSBuild && <CommunicationMethodToggle />}
        <Button id="controller-connect" className="bg-blue">
            <FontAwesomeIcon icon={faPlug} className="busyIcon mr-2" />
            <FontAwesomeIcon icon={faSpinner} className="busySpinner mr-2 hidden! fa-spin" />
            <span class="controller-connect-label text-white!">Connect to Ro/Box</span>
        </Button>
    </div>
</div>
<script>
    import { pico } from "@/libs/communication/communicate";
    import { setButtonBusy } from "@/components/busyButton";
    import {
        dispatchStageAdvance,
        dispatchStageClearError,
        dispatchStageError,
    } from "@/components/stageFlow";
    import {
        ConnectionStatus,
        FirmwareStatus,
        type CommunicationMethod,
        type PicoState,
    } from "src/types/communication";
    import { controllerLink } from "../protocol/controllerLink";

    const NAMESPACE = "controller";

    const errorText = (error: unknown) =>
        error instanceof Error ? error.message : String(error);

    document.querySelectorAll<HTMLDivElement>(".controllerConnect").forEach((root) => {
        const connectButton = root.querySelector<HTMLButtonElement>("#controller-connect");
        const connectLabel = root.querySelector<HTMLElement>(".controller-connect-label");
        if (!connectButton || !connectLabel) throw new Error("Controller connect elements not found");
        const button = connectButton;
        const label = connectLabel;

        if (root.dataset.iosBuild === "true") void pico.setCommunicationMethod("iOSBluetooth");

        // One automatic attempt per connection; after a failure the button retries.
        let attempted = false;
        let starting = false;

        function updateUI(state: PicoState = pico.getState()) {
            const connecting = state.connectionStatus === ConnectionStatus.CONNECTING;
            setButtonBusy(button, connecting || starting);
            if (!connecting && !starting) button.disabled = !state.communicationMethod;
            label.textContent = pico.isConnected() ? "Start Controller" : "Connect to Ro/Box";
        }

        async function startController() {
            if (starting || controllerLink.state !== "idle") return;

            starting = true;
            attempted = true;
            updateUI();
            dispatchStageClearError(root, NAMESPACE);

            try {
                await controllerLink.start();
                dispatchStageAdvance(root, NAMESPACE, "drive");
            } catch (error) {
                dispatchStageError(root, NAMESPACE, "Controller Unavailable", errorText(error));
            } finally {
                starting = false;
                updateUI();
            }
        }

        pico.on("stateChange", (state) => {
            const ready =
                state.connectionStatus === ConnectionStatus.CONNECTED &&
                state.firmwareStatus === FirmwareStatus.UP_TO_DATE &&
                !state.rawMode;

            if (state.connectionStatus === ConnectionStatus.DISCONNECTED) attempted = false;
            if (ready && !attempted) void startController();
            updateUI(state);
        });

        pico.on("error", (data) => {
            if (controllerLink.active) return;
            dispatchStageError(root, NAMESPACE, "Couldn't Connect", data.message);
        });

        button.addEventListener("click", () => {
            dispatchStageClearError(root, NAMESPACE);
            if (pico.isConnected()) {
                void startController();
            } else {
                pico.request();
            }
        });

        updateUI();

        const params = new URLSearchParams(window.location.search);
        const handoffMethod = params.get("connectionMethod") as Exclude<CommunicationMethod, null> | null;
        const handoffDeviceId = params.get("deviceId");
        if (handoffMethod && handoffDeviceId) {
            button.disabled = true;
            void (async () => {
                try {
                    await pico.setCommunicationMethod(handoffMethod);
                    await pico.autoConnect(handoffDeviceId);
                } catch (error) {
                    dispatchStageAdvance(root, NAMESPACE, "connect");
                    dispatchStageError(root, NAMESPACE, "Couldn't Connect", errorText(error));
                }
            })();
        }
    });
</script>
