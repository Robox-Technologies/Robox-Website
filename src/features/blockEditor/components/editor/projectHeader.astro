---
import Button from "@components/button";
import ProjectRename from "@features/blockEditor/components/editor/projectRename";
import ProjectSettings from "@features/blockEditor/components/editor/projectSettings";
import { faChevronLeft } from "@fortawesome/free-solid-svg-icons";
import ExtensionsDialog from "@features/blockEditor/components/extensionsDialog";
---
<div class="editorHeader flex flex-row justify-between items-center h-18 bg-red border-b-2 border-black px-8">
    <Button href="/student" icon={faChevronLeft} className="text-white h-4 w-4 p-0! flex justify-center items-center"/>
    <ProjectRename client:load />
    <div class="flex flex-row gap-4">
        <ExtensionsDialog client:only="react" />
        <ProjectSettings client:load/>

    </div>
    
</div>