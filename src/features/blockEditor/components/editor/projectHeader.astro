---
import Button from "@/components/button";
import ProjectRename from "@/features/blockEditor/components/editor/projectRename.astro";
import ProjectSettings from "@/features/blockEditor/components/editor/projectSettings.astro";
import { faChevronLeft } from "@fortawesome/free-solid-svg-icons";
import ExtensionsDialog from "@/features/blockEditor/components/extensionsDialog.astro";

const isIOSBuild = process.env.IOS_BUILD === 'true';
---
<div class="editorHeader flex flex-row justify-between items-center h-18 bg-red px-8">
    <Button 
        href="../"
        icon={faChevronLeft}
        iconStyle="fa-xl"
        className="text-white h-8 w-8 p-0! flex justify-center items-center"
        onClick={isIOSBuild ? (event: React.MouseEvent<HTMLButtonElement>) => {
            event.preventDefault(); 
            window.history.back();
        } : undefined}
    />
    <ProjectRename />
    <div class="flex flex-row gap-4">
        <!-- <ExtensionsDialog /> -->
        {!isIOSBuild && <ProjectSettings />}

    </div>
    
</div>