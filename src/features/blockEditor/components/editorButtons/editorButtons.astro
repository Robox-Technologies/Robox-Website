---
import CommunicationSlot from "./communicationSlot.astro";
import MainButton from "./mainButton";
import UndoRedo from "./undoRedo.astro";
import ZoomButtons from "./zoomButtons.astro";
---
<div class="right-0 bottom-0 p-8 h-full absolute flex flex-col justify-between z-40 pointer-events-none">
    <div class="h-fit w-full justify-end items-end flex">
        <UndoRedo />
    </div>
    <div class="flex flex-col items-end gap-4">
        <div class="flex flex-col items-end gap-4">
            <CommunicationSlot />
            <ZoomButtons />
        </div>
        <MainButton client:only="react" />
    </div>
</div>