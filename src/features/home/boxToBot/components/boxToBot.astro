---
import step1Image from '@/images/boxToBot/step1.svg';
import step2Image from '@/images/boxToBot/step2.svg';
import step3Image from '@/images/boxToBot/step3.svg';
import step4Image from '@/images/boxToBot/step4.svg';
import Step from './Step';

const steps = [
    {
        stepNumber: 1,
        title: "Unbox Your Ro/Box",
        description: "Open the packaging and familiarise yourself with all the components.",
        image: step1Image
    },
    {
        stepNumber: 2,
        title: "Assemble",
        description: "Follow our comprehensive guide to build your Ro/Box.",
        image: step2Image
    },
    {
        stepNumber: 3,
        title: "Unleash your creativity",
        description: "Design and customise to truly make Ro/Box your own.",
        image: step3Image
    },
    {
        stepNumber: 4,
        title: "Code",
        description: "Use our beginner-friendly block code editor to bring your creation to life.",
        image: step4Image
    },
];
---
<script>
    import step1Image from '@/images/boxToBot/step1.svg';
    import step2Image from '@/images/boxToBot/step2.svg';
    import step3Image from '@/images/boxToBot/step3.svg';
    import step4Image from '@/images/boxToBot/step4.svg';

    const images = [
        step1Image.src,
        step2Image.src,
        step3Image.src,
        step4Image.src
    ]

    let currentImgIndex = 0;
    const scaleAnimation = "scale-animate";
    function updateBoxToBot() {
        const stepDivs = document.querySelectorAll<HTMLDivElement>("div.step");
        const imageEl = document.querySelector<HTMLImageElement>("img.boxToBotImg");
        if (!imageEl || stepDivs.length === 0) return;

        let imgIndex = 0;

        for (let i = 0; i < stepDivs.length - 1; i++) {
            const step = stepDivs[i];
            const nextStep = stepDivs[i + 1];

            const midpoint =(step.getBoundingClientRect().bottom + nextStep.getBoundingClientRect().top) / 2;

            if (midpoint > window.innerHeight / 2) break;
            imgIndex++;
        }

        if (imgIndex === currentImgIndex) return;

        const image = images[imgIndex];
        if (!image) return;

        imageEl.src = image;

        imageEl.classList.remove(scaleAnimation);
        void imageEl.offsetWidth;
        imageEl.classList.add(scaleAnimation);

        currentImgIndex = imgIndex;
    }

    document.addEventListener("scroll", updateBoxToBot);
    updateBoxToBot();
</script>

<article id="box-to-bot" class="bg-[#23344b]">
    <section class="flex flex-col w-full relative">
        <div class="intro py-8 lg:absolute w-full">
            <h1 class="text-6xl text-white font-bold mb-8 text-center">
                Box-to-Bot in 4 Steps
            </h1>
            <p class="text-xl text-white text-center">
                We know how difficult robotics can be.<br>
                Its why we've made Ro/Box easy to follow for all ages.
            </p>
        </div>
        <div class="columns flex flex-col items-start lg:flex-row gap-8 max-w-[800px] m-auto flex-1">
            <div class="steps flex flex-col gap-12 lg:w-1/2 pb-8">
                {steps.map((step) => (
                    <Step
                        stepNumber={step.stepNumber} 
                        title={step.title} 
                        description={step.description}
                        image={step.image.src}
                    />
                ))}
            </div>
            <img src={step1Image.src} alt="" aria-hidden="true" class="boxToBotImg w-[250px] sticky top-0 object-contain pt-[calc(max(45vh,250px)-55px)] ml-auto hidden lg:block"/>
        </div>
    </section>
</article>