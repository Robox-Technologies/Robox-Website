---
import Article from '@/components/article/Article';
import ProductCard from './components/card';
import SingleThumbnail from '@/images/shop/products/robox/thumbnail.jpg'
import PackThumbnail from '@/images/shop/products/robox-10-pack/thumbnail.jpg'


import Button from '@/components/button';
import { getAllProducts } from '@/utils/server/stripe/getAllProducts.server'

const products = await getAllProducts()

/** Curated presentation here; name, availability and price come from the catalog. */
function featured(internalName: string) {
    const product = products.find(
        (candidate) => candidate.internalName === internalName,
    )
    if (!product) {
        throw new Error(
            `The homepage features "${internalName}", which is not in the Stripe catalog`,
        )
    }
    return product
}

const single = featured('robox')
const tenPack = featured('robox-10-pack')
---
<Article>
    <section>
        <h1 class="text-5xl font-bold mb-8 text-center">
            Check out our Kits
        </h1>
        <div class="flex flex-col justify-center items-center text-center max-w-3xl mx-auto text-xl">
            <p>
                Begin your journey with Ro/Box.
            </p>
        </div>
        <div class="flex justify-center gap-16 mt-8 flex-wrap">
            <ProductCard image={SingleThumbnail} product={single} />
            <ProductCard
                className='border-8 border-green'
                image={PackThumbnail}
                product={tenPack}
            >
                <h2 slot="absolute" class="absolute text-white px-4 py-2 text-xl font-bold bg-green rounded-bl -right-[4px] -top-[4px]">Value Pack</h2>
                
            </ProductCard>
        </div>
        <div class="mt-8 flex justify-center text-center mb-16">
            <Button href="/shop" className="bg-red text-2xl box-shadow p-4 mx-auto block">
                Visit Our Shop
            </Button>
        </div>
    </section>
</Article>