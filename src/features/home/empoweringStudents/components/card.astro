---
import BaseCard from '@/components/card';
import { Image } from 'astro:assets';
interface Props {
    image: ImageMetadata;
    /** Describes `image`; each card shows something different. */
    imageAlt: string;
    title: string;
    description: string;
}
const { image, imageAlt, title, description } : Props = Astro.props;
const hasGoober = Astro.slots.has('goober');
---
<div class:list={["relative w-[350px] basis-[350px]", hasGoober && "isolate"]}>
    <slot name="goober" />
    {/* Background belongs on the card itself, not the content block: the card
         adds padding below the content, which showed through as a bare strip. */}
    <BaseCard
        className='w-full h-full box-shadow bg-white'
        description={description}
    >
        {/* Cards are 350px wide; 700 covers 2x screens. */}
        <Image
            slot="image"
            src={image}
            alt={imageAlt}
            class="w-full h-auto"
            widths={[350, 700]}
            sizes="350px"
            width={700}
            height={Math.round((700 * image.height) / image.width)}
        />
        <h2 slot="title" class="text-2xl font-bold mb-4">{title}</h2>
        <p slot="description" class="text-lg">
            {description}
        </p>
    </BaseCard>
</div>
