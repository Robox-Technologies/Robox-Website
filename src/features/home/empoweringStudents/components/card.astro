---
import BaseCard from '@/components/card';
import { Image } from 'astro:assets';
interface Props {
    image: ImageMetadata;
    title: string;
    description: string;
}
const { image, title, description } : Props = Astro.props;
const hasGoober = Astro.slots.has('goober');
---
<div class:list={["relative w-[350px] basis-[350px]", hasGoober && "isolate"]}>
    <slot name="goober" />
    <!-- Background belongs on the card itself, not the content block: the card
         adds padding below the content, which showed through as a bare strip. -->
    <BaseCard
        className='w-full box-shadow bg-white'
        description={description}
    >
        <Image slot="image" src={image} alt="Robotics Kit Components" class="w-full h-auto rounded-t-lg" width={image.width} height={image.height}/>
        <h2 slot="title" class="text-2xl font-bold mb-4">{title}</h2>
        <p slot="description" class="text-lg">
            {description}
        </p>
    </BaseCard>
</div>
