---
import Article from '@components/article/Article';
import Card from '@components/card.astro';
import roboxHubCard1 from '@images/index/roboxHubCard1.png';
import roboxHubCard2 from '@images/index/roboxHubCard2.png';
import roboxHubCard3 from '@images/index/roboxHubCard3.png';

import EmpoweringStudentsCard from './components/card.astro';
---
<Article>
    <section>
        <h1 class="text-6xl font-bold mb-8 text-center">
            Empowering Students to Learn
        </h1>
        <div class="flex flex-col justify-center items-center text-center max-w-3xl mx-auto text-xl">
            <span class="font-bold" >Interactive, hands-on, and made for curious minds.<br></span>
            <p>
                Ro/Box Hub gives learners everything they need to dive into<br>
                the world of robotics—from step-by-step instructions<br>
                to creative coding challenges.
            </p>
        </div>
        <div class="flex justify-evenly gap-8 mt-8 flex-wrap">
            <EmpoweringStudentsCard
                image={roboxHubCard1}
                title="Step-by-Step Instructions"
                description="Comprehensive guides walk students through building and programming their robots, ensuring a smooth learning experience."
            />
            <EmpoweringStudentsCard
                image={roboxHubCard2}
                title="Workshop"
                description="Explore block coding through interactive exercises that teach how to control your Ro/Box’s movements, sensors, and actions."
            />
            <EmpoweringStudentsCard
                image={roboxHubCard3}
                title="Lessons"
                description="Build real coding skills with our structured lessons that introduce programming in a simple, visual way using our block code editor."
            />  

        </div>
    </section>
</Article>