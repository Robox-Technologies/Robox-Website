---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faEyeDropper, faSpinner, faPlugCircleXmark } from '@fortawesome/free-solid-svg-icons';
import Button from '@/components/button';
---
<div class="calibrationCalibrate flex flex-col gap-4">
    <p class="text-gray-800">
        Make sure the colour sensor has a clear view of the surface it will
        be reading from, then press Calibrate.
    </p>
    <Button id="calibrate-button" className="bg-blue self-start">
        <FontAwesomeIcon icon={faEyeDropper} className="busyIcon mr-2" />
        <FontAwesomeIcon icon={faSpinner} className="busySpinner mr-2 hidden! fa-spin" />
        Calibrate
    </Button>
    <Button id="calibration-disconnected" className="bg-gray-500 self-start hidden">
        <FontAwesomeIcon icon={faPlugCircleXmark} className="mr-2" />
        Ro/Box Not Connected — Back to Connect
    </Button>
</div>
<script>
    import { pico } from "@/libs/communication/communicate";
    import type { PicoEventMap, PicoState } from "src/types/communication";
    import { ConnectionStatus } from "src/types/communication";
    import { setButtonBusy, dispatchCalibrationAdvance, dispatchCalibrationClearError, dispatchCalibrationError } from "../stage";

    /**
     * Calibration involves an actual sensor read on the board, not just an
     * echoed command, so this is more generous than the firmware check's
     * timeout - long enough for a healthy board to genuinely finish before
     * being reported as unresponsive.
     */
    const CALIBRATION_TIMEOUT_MS = 6000;

    // Astro only includes this script once no matter how many instances
    // render, so wire up every instance found rather than assuming there's a
    // single one.
    document.querySelectorAll<HTMLDivElement>(".calibrationCalibrate").forEach((root) => {
        const calibrateButton = root.querySelector<HTMLButtonElement>("#calibrate-button");
        const disconnectedButton = root.querySelector<HTMLButtonElement>("#calibration-disconnected");
        if (!calibrateButton || !disconnectedButton) throw new Error("Calibrate stage elements not found");

        let waitingForResult = false;
        let timeoutHandle: ReturnType<typeof setTimeout> | null = null;

        function clearTimer() {
            if (timeoutHandle) clearTimeout(timeoutHandle);
            timeoutHandle = null;
        }

        function finish(action: () => void) {
            clearTimer();
            waitingForResult = false;
            setButtonBusy(calibrateButton!, false);
            action();
        }

        // Reachable either by URL (a reload or a bookmark landing straight
        // on `?step=calibrate`) or by the Ro/Box dropping out mid-stage, not
        // just by arriving here normally from a successful Connect stage —
        // so this stage checks the connection itself rather than trusting
        // that it was already verified upstream.
        function updateConnectionUI(state: PicoState) {
            const connected = state.connectionStatus === ConnectionStatus.CONNECTED;
            if (!connected && waitingForResult) {
                // Nothing is going to answer a request sent to a Ro/Box
                // that's no longer there.
                finish(() => dispatchCalibrationClearError(root));
            }
            calibrateButton!.classList.toggle("hidden", !connected);
            disconnectedButton!.classList.toggle("hidden", connected);
        }

        pico.on("stateChange", updateConnectionUI);
        updateConnectionUI(pico.getState());

        pico.on("calibrated", () => {
            if (!waitingForResult) return;
            finish(() => {
                // Colour mode is what drives the live preview on the Done
                // stage - entering it here, right on a successful
                // calibration, rather than from that stage itself, means it
                // only ever starts as a direct consequence of calibrating.
                pico.colorMode();
                dispatchCalibrationAdvance(root, "done");
            });
        });

        pico.on("error", (data: PicoEventMap["error"]) => {
            if (!waitingForResult) return;
            finish(() => dispatchCalibrationError(root, "Calibration Failed", data.message));
        });

        calibrateButton.addEventListener("click", () => {
            dispatchCalibrationClearError(root);
            setButtonBusy(calibrateButton, true);
            waitingForResult = true;
            pico.colorCalibrate();

            clearTimer();
            timeoutHandle = setTimeout(() => {
                if (!waitingForResult) return;
                finish(() =>
                    dispatchCalibrationError(
                        root,
                        "Calibration Failed",
                        "The Ro/Box didn't respond to the calibration request. Check that it's connected, then try again.",
                    ),
                );
            }, CALIBRATION_TIMEOUT_MS);
        });

        disconnectedButton.addEventListener("click", () => {
            dispatchCalibrationClearError(root);
            dispatchCalibrationAdvance(root, "connect");
        });
    });
</script>
