---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faPlug, faSpinner } from '@fortawesome/free-solid-svg-icons';
import Button from '@/components/button';
import CommunicationMethodToggle from '@/components/communicationMethodToggle.astro';

// The iOS app only ever talks over its own BLE plugin, so there's no method
// to pick — same as the editor's own communicationSlot.
const isIOSBuild = process.env.IOS_BUILD === 'true';
---
<div class="calibrationConnect flex flex-col gap-3" data-ios-build={isIOSBuild ? "true" : "false"}>
    <div class="flex items-center gap-3">
        {!isIOSBuild && <CommunicationMethodToggle />}
        <Button id="calibration-connect" className="bg-blue">
            <FontAwesomeIcon icon={faPlug} className="busyIcon mr-2" />
            <FontAwesomeIcon icon={faSpinner} className="busySpinner mr-2 hidden! fa-spin" />
            Connect to Ro/Box
        </Button>
    </div>
</div>
<script>
    import { pico } from "@/libs/communication/communicate";
    import { toast } from "@/libs/ui/toast";
    import type { PicoState } from "src/types/communication";
    import { ConnectionStatus } from "src/types/communication";
    import { setButtonBusy, dispatchCalibrationAdvance, CALIBRATION_READY_EVENT } from "../stage";

    // Astro includes this script once however many instances render, so wire up each one.
    document.querySelectorAll<HTMLDivElement>(".calibrationConnect").forEach((root) => {
        const connectButton = root.querySelector<HTMLButtonElement>("#calibration-connect");
        if (!connectButton) throw new Error("Calibration connect elements not found");

        if (root.dataset.iosBuild === "true") {
            void pico.setCommunicationMethod("iOSBluetooth");
        }

        // An already-connected Ro/Box skips this stage. Reset on every disconnect, so a
        // drop that sends the student back here still advances on the next reconnect.
        let hasAdvanced = false;

        // Two checks run before advancing, in this order:
        //
        // 1. "sensor": colorMode(), waiting for its first `color` reading.
        //    Without a colour sensor the board refuses it - pico already
        //    toasts that error, so this just disconnects and stays here
        //    rather than advancing to a stage that can't work.
        // 2. "calibration": getCalibration("colors"), waiting on
        //    `CALIBRATION_READY_EVENT` - fired by the Calibrate stage only
        //    once its swatches show the value, so it's never revealed still
        //    showing "nothing calibrated". A board too old to answer just
        //    times out (or errors) and advances anyway.
        //
        // The sensor check goes first so a missing sensor is reported once,
        // by colour mode, before any other request can fail because of it.
        const SENSOR_CHECK_TIMEOUT_MS = 3000;
        const CALIBRATION_FETCH_TIMEOUT_MS = 2000;
        let phase: "idle" | "sensor" | "calibration" = "idle";
        let phaseTimeout: ReturnType<typeof setTimeout> | null = null;

        function clearPhase() {
            phase = "idle";
            if (phaseTimeout) clearTimeout(phaseTimeout);
            phaseTimeout = null;
            document.removeEventListener(CALIBRATION_READY_EVENT, finishCalibrationWait);
        }

        function startSensorCheck() {
            phase = "sensor";
            phaseTimeout = setTimeout(() => {
                failSensorCheck();
                toast.danger({
                    title: "Colour Sensor Not Found",
                    message: "The Ro/Box didn't send any colour readings. Check the colour sensor is plugged in, then connect again.",
                });
            }, SENSOR_CHECK_TIMEOUT_MS);
            pico.colorMode();
        }

        function failSensorCheck() {
            clearPhase();
            void pico.disconnect();
        }

        function startCalibrationWait() {
            clearPhase();
            phase = "calibration";
            document.addEventListener(CALIBRATION_READY_EVENT, finishCalibrationWait);
            phaseTimeout = setTimeout(finishCalibrationWait, CALIBRATION_FETCH_TIMEOUT_MS);
            pico.getCalibration("colors");
        }

        function finishCalibrationWait() {
            if (phase !== "calibration") return;
            clearPhase();
            // getCalibration() was a command frame, which exits colour mode on the board.
            pico.colorMode();
            dispatchCalibrationAdvance(root, "calibrate");
            updateUI(pico.getState());
        }

        pico.on("color", () => {
            if (phase === "sensor") startCalibrationWait();
        });

        // Only an explicit click may connect here, so auto-connect stays off. Queued to
        // the next microtask because `setCommunicationMethod` builds its fresh transport
        // (auto-connect back on) after emitting this stateChange.
        function disableUsbAutoConnect(state: PicoState) {
            if (state.communicationMethod !== "USB") return;
            queueMicrotask(() => pico.setAutoConnect(false));
        }

        function updateUI(state: PicoState) {
            disableUsbAutoConnect(state);
            const connecting = state.connectionStatus === ConnectionStatus.CONNECTING;
            const connected = state.connectionStatus === ConnectionStatus.CONNECTED;
            if (connected) {
                if (!hasAdvanced) {
                    hasAdvanced = true;
                    startSensorCheck();
                }
            } else {
                hasAdvanced = false;
                clearPhase();
            }
            const checking = phase !== "idle";
            setButtonBusy(connectButton!, connecting || checking);
            // Nothing to connect to until the toggle (or the iOS branch) sets a method.
            if (!connecting && !checking) connectButton!.disabled = !state.communicationMethod;
        }

        pico.on("stateChange", updateUI);
        updateUI(pico.getState());

        // pico toasts every error itself, so this only settles the checks.
        pico.on("error", () => {
            // The board refusing colour mode - no colour sensor attached.
            // pico has already toasted its message, which says exactly that.
            if (phase === "sensor") {
                failSensorCheck();
                return;
            }
            // A refused `get_calibration_colors` (e.g. firmware too old to
            // recognise it) answers with this same generic error type -
            // not a connection failure, so just move on.
            if (phase === "calibration") {
                finishCalibrationWait();
                return;
            }
        });

        connectButton.addEventListener("click", () => {
            pico.request();
        });
    });
</script>
