---
interface Props {
    id: string
    label: string
    ariaLabel: string
    class?: string
}
const { id, label, ariaLabel, class: className } = Astro.props
---

<label for={id} class:list={["flex cursor-pointer flex-col items-center gap-1.5 justify-self-center", className]}>
    <span class="text-sm font-semibold text-black">{label}</span>
    <button
        type="button"
        id={id}
        role="switch"
        aria-checked="false"
        aria-label={ariaLabel}
        class="motor-toggle button-interactive relative h-7 w-12 shrink-0 rounded-full bg-secondary"
    >
        <span class="motor-toggle-thumb absolute top-1 left-1 block size-5 rounded-full bg-white"></span>
    </button>
</label>

<style>
    .motor-toggle {
        transition: background-color 150ms ease-out;
    }
    .motor-toggle[aria-checked='true'] {
        background-color: var(--color-blue);
    }

    .motor-toggle-thumb {
        transition: transform 150ms ease-out;
    }
    /* 48px track - 20px thumb - 4px inset each side. */
    .motor-toggle[aria-checked='true'] .motor-toggle-thumb {
        transform: translateX(20px);
    }
</style>
