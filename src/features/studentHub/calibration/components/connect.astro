---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faPlug, faSpinner } from '@fortawesome/free-solid-svg-icons';
import Button from '@/components/button';
import CommunicationMethodToggle from '@/components/communicationMethodToggle.astro';

interface Props {
    namespace: string
    calibration: 'colors' | 'motors'
}

const { namespace, calibration } = Astro.props;
const isIOSBuild = process.env.IOS_BUILD === 'true';
---
<div
    class="calibrationConnect flex flex-col gap-3"
    data-calibration-namespace={namespace}
    data-calibration-name={calibration}
    data-ios-build={isIOSBuild ? "true" : "false"}
>
    <div class="flex items-center gap-3">
        {!isIOSBuild && <CommunicationMethodToggle />}
        <Button id="calibration-connect" className="bg-blue">
            <FontAwesomeIcon icon={faPlug} className="busyIcon mr-2" />
            <FontAwesomeIcon icon={faSpinner} className="busySpinner mr-2 hidden! fa-spin" />
            Connect to Ro/Box
        </Button>
    </div>
</div>
<script>
    import { pico } from "@/libs/communication/communicate";
    import { toast } from "@/libs/ui/toast";
    import type { PicoState } from "src/types/communication";
    import { ConnectionStatus } from "src/types/communication";
    import { setButtonBusy } from "@/components/busyButton";
    import { dispatchStageAdvance } from "@/components/stageFlow";
    import { debugCalibration } from "../stage";

    const SENSOR_CHECK_TIMEOUT_MS = 3000;
    const CALIBRATION_FETCH_TIMEOUT_MS = 2000;

    document.querySelectorAll<HTMLDivElement>(".calibrationConnect").forEach((root) => {
        const connectButton = root.querySelector<HTMLButtonElement>("#calibration-connect");
        const namespace = root.dataset.calibrationNamespace;
        const calibration = root.dataset.calibrationName;
        if (!connectButton || !namespace || (calibration !== "colors" && calibration !== "motors")) {
            throw new Error("Calibration connect elements not found");
        }
        const button = connectButton;
        const stageNamespace = namespace;
        const calibrationName = calibration;
        const debug = (message: string, details?: unknown) =>
            debugCalibration(stageNamespace, message, details);
        let lastStatus = "";

        if (root.dataset.iosBuild === "true") {
            debug("Selecting iOS Bluetooth communication");
            void pico.setCommunicationMethod("iOSBluetooth");
        }
        debug("Connection stage mounted", {
            calibration: calibrationName,
            initialState: pico.getState(),
        });

        // An already-connected Ro/Box skips this stage. Reset on every disconnect, so a
        // drop that sends the student back here still advances on the next reconnect.
        let hasAdvanced = false;

        // Checks run before advancing, in this order:
        //
        // 1. "sensor" (colour only): colorMode(), waiting for its first
        //    `color` reading. Without a colour sensor the board refuses it -
        //    pico already toasts that error, so this just disconnects and
        //    stays here rather than advancing to a stage that can't work.
        // 2. "calibration": getCalibration(), waiting on the Calibrate
        //    stage's ready event - fired only once its controls show the
        //    value, so it's never revealed still showing defaults. A board
        //    too old to answer just times out (or errors) and advances anyway.
        //
        // The sensor check goes first so a missing sensor is reported once,
        // by colour mode, before any other request can fail because of it.
        let phase: "idle" | "sensor" | "calibration" = "idle";
        let phaseTimeout: ReturnType<typeof setTimeout> | null = null;
        const calibrationReadyEvent = `${namespace}:calibration-ready`;

        function clearPhase() {
            phase = "idle";
            if (phaseTimeout) clearTimeout(phaseTimeout);
            phaseTimeout = null;
            document.removeEventListener(calibrationReadyEvent, finishCalibrationWait);
        }

        function startSensorCheck() {
            debug("Checking colour sensor");
            phase = "sensor";
            phaseTimeout = setTimeout(() => {
                failSensorCheck();
                toast.danger({
                    title: "Colour Sensor Not Found",
                    message: "The Ro/Box didn't send any colour readings. Check the colour sensor is plugged in, then connect again.",
                });
            }, SENSOR_CHECK_TIMEOUT_MS);
            pico.colorMode();
        }

        // Hidden while the Calibrate stage shows, e.g. after a handoff from
        // the editor lands straight on ?step=calibrate.
        const ownStage = root.closest<HTMLElement>(".stageFlowStage");

        function failSensorCheck() {
            debug("Colour sensor check failed; disconnecting");
            clearPhase();
            // Back to Connect first, so the Calibrate stage doesn't treat the
            // disconnect below as a drop and toast about it too.
            if (ownStage?.classList.contains("hidden")) {
                dispatchStageAdvance(root, stageNamespace, "connect");
            }
            void pico.disconnect();
        }

        function startCalibrationWait() {
            clearPhase();
            phase = "calibration";
            document.addEventListener(calibrationReadyEvent, finishCalibrationWait);
            phaseTimeout = setTimeout(finishCalibrationWait, CALIBRATION_FETCH_TIMEOUT_MS);
            debug(`Requesting ${calibrationName} calibration`);
            pico.getCalibration(calibrationName);
        }

        function finishCalibrationWait() {
            if (phase !== "calibration") return;
            debug("Calibration read finished; advancing to calibrate stage");
            clearPhase();
            // getCalibration() was a command frame, which exits colour mode on the board.
            if (calibrationName === "colors") pico.colorMode();
            dispatchStageAdvance(root, stageNamespace, "calibrate");
            updateUI(pico.getState());
        }

        pico.on("color", () => {
            if (phase === "sensor") startCalibrationWait();
        });

        function updateUI(state: PicoState) {
            const statusKey = `${state.connectionStatus}:${state.firmwareStatus}`;
            if (statusKey !== lastStatus) {
                lastStatus = statusKey;
                debug("Connection state changed", {
                    connectionStatus: state.connectionStatus,
                    firmwareStatus: state.firmwareStatus,
                    communicationMethod: state.communicationMethod,
                });
            }
            const connecting = state.connectionStatus === ConnectionStatus.CONNECTING;
            const connected = state.connectionStatus === ConnectionStatus.CONNECTED;
            if (connected) {
                if (!hasAdvanced) {
                    hasAdvanced = true;
                    if (calibrationName === "colors") startSensorCheck();
                    else startCalibrationWait();
                }
            } else {
                hasAdvanced = false;
                clearPhase();
            }
            const checking = phase !== "idle";
            setButtonBusy(button, connecting || checking);
            if (!connecting && !checking) {
                button.disabled = !state.communicationMethod;
            }
        }

        pico.on("stateChange", updateUI);
        updateUI(pico.getState());

        // pico toasts every error itself, so this only settles the checks.
        pico.on("error", (data) => {
            debug("Communication error", { message: data.message, phase });
            // The board refusing colour mode - no colour sensor attached.
            if (phase === "sensor") {
                failSensorCheck();
                return;
            }
            // A refused get_calibration (e.g. firmware too old to recognise
            // it) answers with this same generic error type - move on.
            if (phase === "calibration") finishCalibrationWait();
        });

        button.addEventListener("click", () => {
            debug("Manual connection requested");
            pico.request();
        });

        const params = new URLSearchParams(window.location.search);
        const handoffMethod = params.get("connectionMethod");
        const handoffDeviceId = params.get("deviceId");
        if (handoffMethod && handoffDeviceId) {
            debug("Connection handoff detected", {
                method: handoffMethod,
                hasDeviceId: true,
            });
            button.disabled = true;
            void (async () => {
                try {
                    debug("Starting handoff connection");
                    await pico.setCommunicationMethod(
                        handoffMethod as "USB" | "WebBluetooth" | "iOSBluetooth",
                    );
                    await pico.autoConnect(handoffDeviceId);
                    debug("Handoff connection completed");
                } catch (error) {
                    const message = error instanceof Error ? error.message : String(error);
                    debug("Handoff connection failed", { message });
                    dispatchStageAdvance(root, stageNamespace, "connect");
                    toast.danger({ title: "Couldn't Connect", message });
                }
            })();
        }
    });
</script>
