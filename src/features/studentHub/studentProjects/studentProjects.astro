---
import ImportButton from "./components//importButton"
import Projects from "./components//projects"

const isIOSBuild = process.env.IOS_BUILD === 'true';
---
<div class="flex flex-wrap justify-start items-center mb-8 gap-4">
    <h1 class="text-5xl font-bold">
        My Projects
    </h1>
    {!isIOSBuild && <ImportButton client:load />}
</div>
<div class="card-holder flex flex-wrap gap-8 w-full">
    <Projects client:load />
</div>
