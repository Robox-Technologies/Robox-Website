---
interface Props {
    id: string
    label: string
}
const { id, label } = Astro.props
---

<div class="w-full flex items-center justify-between gap-3">
    <span class="text-sm font-semibold">{label}</span>
    <button
        type="button"
        id={id}
        role="switch"
        aria-checked="false"
        aria-label={label}
        class="motor-toggle button-interactive w-12 h-6 px-0.5 rounded-full bg-gray-300 shrink-0"
    >
        <span class="motor-toggle-thumb block size-5 rounded-full bg-white shadow-md"
        ></span>
    </button>
</div>

<style>
    .motor-toggle {
        transition: background-color 150ms ease-out;
    }

    .motor-toggle[aria-checked="true"] {
        background-color: #000;
    }

    .motor-toggle-thumb {
        transition: transform 150ms ease-out;
    }

    .motor-toggle[aria-checked="true"] .motor-toggle-thumb {
        transform: translateX(1.5rem);
    }
</style>
