---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faPlug, faSpinner } from '@fortawesome/free-solid-svg-icons';
import Button from '@/components/button';
import CommunicationMethodToggle from '@/components/communicationMethodToggle.astro';

// The iOS app only ever talks over its own BLE plugin, so there's no method
// to pick — same as the editor's own communicationSlot.
const isIOSBuild = process.env.IOS_BUILD === 'true';
---
<div class="calibrationConnect flex flex-col gap-3" data-ios-build={isIOSBuild ? "true" : "false"}>
    <div class="flex items-center gap-3">
        {!isIOSBuild && <CommunicationMethodToggle />}
        <Button id="calibration-connect" className="bg-blue">
            <FontAwesomeIcon icon={faPlug} className="busyIcon mr-2" />
            <FontAwesomeIcon icon={faSpinner} className="busySpinner mr-2 hidden! fa-spin" />
            Connect to Ro/Box
        </Button>
    </div>
</div>
<script>
    import { pico } from "@/libs/communication/communicate";
    import type { PicoState } from "src/types/communication";
    import { ConnectionStatus } from "src/types/communication";
    import { setButtonBusy, dispatchCalibrationAdvance, dispatchCalibrationClearError, dispatchCalibrationError, CALIBRATION_READY_EVENT } from "../stage";

    // Astro only includes this script once no matter how many instances
    // render, so wire up every instance found rather than assuming there's a
    // single one.
    document.querySelectorAll<HTMLDivElement>(".calibrationConnect").forEach((root) => {
        const connectButton = root.querySelector<HTMLButtonElement>("#calibration-connect");
        if (!connectButton) throw new Error("Calibration connect elements not found");

        if (root.dataset.iosBuild === "true") {
            void pico.setCommunicationMethod("iOSBluetooth");
        }

        // A Ro/Box that's already connected (e.g. arriving here straight from
        // the editor) skips straight past this stage instead of asking to
        // reconnect to a device that's already talking to us. Resets on
        // every disconnect rather than firing once for the whole page's
        // lifetime, so coming back here after the Calibrate stage sends you
        // back (a dropped connection) still advances on the next reconnect.
        let hasAdvanced = false;

        // Fetched here, before advancing, rather than by the Calibrate
        // stage's own script once it's visible - that ordering left the
        // panel showing its default "nothing calibrated" state for a beat
        // before the reply arrived and updated it. Advancing waits on
        // `CALIBRATION_READY_EVENT`, which the Calibrate stage's own script
        // fires only after it has applied the value to its controls -
        // rather than on the raw pico `calibration` reply here, which would
        // only prove the *board* answered, not that the *panel* has caught
        // up. Short-lived: this is a local config read, not a live sensor
        // calibration (unlike `CALIBRATION_TIMEOUT_MS` in the Calibrate
        // stage), and a board too old to answer just times out and advances
        // anyway rather than blocking the student here.
        const CALIBRATION_FETCH_TIMEOUT_MS = 2000;
        let awaitingCalibration = false;
        let calibrationTimeout: ReturnType<typeof setTimeout> | null = null;

        function finishCalibrationWait() {
            if (!awaitingCalibration) return;
            awaitingCalibration = false;
            if (calibrationTimeout) clearTimeout(calibrationTimeout);
            calibrationTimeout = null;
            document.removeEventListener(CALIBRATION_READY_EVENT, finishCalibrationWait);
            dispatchCalibrationAdvance(root, "calibrate");
        }

        function cancelCalibrationWait() {
            if (!awaitingCalibration) return;
            awaitingCalibration = false;
            if (calibrationTimeout) clearTimeout(calibrationTimeout);
            calibrationTimeout = null;
            document.removeEventListener(CALIBRATION_READY_EVENT, finishCalibrationWait);
        }

        // Silently reattaching to a previously authorised USB port the
        // instant this stage becomes active would start test-driving motors
        // on whatever Ro/Box that port belongs to without the student
        // clicking anything - only an explicit click on the button below may
        // connect here. `setCommunicationMethod` (called by the toggle
        // above, or by the iOS branch) builds a fresh USBCommunication that
        // defaults auto-connect back on, and it does so *after* emitting
        // this very stateChange - queuing this for the next microtask,
        // rather than calling it inline, is what lets it land on that new
        // transport instead of the one just torn down.
        function disableUsbAutoConnect(state: PicoState) {
            if (state.communicationMethod !== "USB") return;
            queueMicrotask(() => pico.setAutoConnect(false));
        }

        function updateUI(state: PicoState) {
            disableUsbAutoConnect(state);
            const connecting = state.connectionStatus === ConnectionStatus.CONNECTING;
            const connected = state.connectionStatus === ConnectionStatus.CONNECTED;
            if (connected) {
                if (!hasAdvanced) {
                    hasAdvanced = true;
                    awaitingCalibration = true;
                    document.addEventListener(CALIBRATION_READY_EVENT, finishCalibrationWait);
                    calibrationTimeout = setTimeout(finishCalibrationWait, CALIBRATION_FETCH_TIMEOUT_MS);
                    pico.getCalibration("motors");
                }
            } else {
                hasAdvanced = false;
                cancelCalibrationWait();
            }
            setButtonBusy(connectButton!, connecting || awaitingCalibration);
            // The toggle picks the method (or the iOS branch above sets it
            // directly) - until one is actually set there's nothing to
            // connect to yet.
            if (!connecting && !awaitingCalibration) connectButton!.disabled = !state.communicationMethod;
        }

        pico.on("stateChange", updateUI);
        updateUI(pico.getState());

        pico.on("error", (data) => {
            // The board answers a refused `get_calibration_motors` (e.g. an
            // older firmware that doesn't recognise it) with this same
            // generic error type - that's not a connection failure, so it
            // must not show "Couldn't Connect" while we're actually
            // connected and simply move on to the Calibrate stage.
            if (awaitingCalibration) {
                finishCalibrationWait();
                return;
            }
            dispatchCalibrationError(root, "Couldn't Connect", data.message);
        });

        connectButton.addEventListener("click", () => {
            dispatchCalibrationClearError(root);
            pico.request();
        });
    });
</script>
