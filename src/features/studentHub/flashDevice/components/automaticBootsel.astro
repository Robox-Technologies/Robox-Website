---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faBolt, faSpinner } from '@fortawesome/free-solid-svg-icons';
import Button from '@/components/button';
---
<div class="automaticBootsel flex flex-col gap-3">
    <p class="automaticBootselNoMethod text-sm text-gray-800 hidden">
        Your browser doesn't support connecting over USB, so do this step
        manually below.
    </p>

    <Button id="flash-connect" className="bg-blue self-start">
        <FontAwesomeIcon icon={faBolt} className="busyIcon mr-2" />
        <FontAwesomeIcon icon={faSpinner} className="busySpinner mr-2 hidden! fa-spin" />
        Reboot via USB
    </Button>
</div>
<script>
    import { pico } from "@/libs/communication/communicate";
    import type { PicoState } from "src/types/communication";
    import { ConnectionStatus } from "src/types/communication";
    import { dispatchFlashAdvance, dispatchFlashClearError, dispatchFlashError, setButtonBusy, type Stage } from "../stage";

    // Astro includes this script once however many instances render, so wire up each one.
    document.querySelectorAll<HTMLDivElement>(".automaticBootsel").forEach((root) => {
        const noMethodNotice = root.querySelector<HTMLParagraphElement>(".automaticBootselNoMethod");
        const connectButton = root.querySelector<HTMLButtonElement>("#flash-connect");
        if (!noMethodNotice || !connectButton) {
            throw new Error("Automatic bootsel elements not found");
        }

        // This flow reports its own inline errors, so the global toasts would be noise.
        pico.setToastsEnabled(false);

        // The button just reflects pico's live connection status, same as
        // everywhere else it's used (e.g. the editor's connect button).
        let hasTriggeredReboot = false;

        function updateUI(state: PicoState) {
            const hasMethod = state.communicationMethod !== null;
            const connecting = state.connectionStatus === ConnectionStatus.CONNECTING;
            const connected = state.connectionStatus === ConnectionStatus.CONNECTED;
            if (connected && !hasTriggeredReboot) {
                hasTriggeredReboot = true;
                pico.bootloaderMode();

                // The reboot re-enumerates the Ro/Box as a drive, so there's no transport
                // left to confirm over; the next step's drive check catches a failure.
                setTimeout(() => dispatchFlashAdvance(root, "flash"), 1500);
            }

            noMethodNotice!.classList.toggle("hidden", hasMethod);
            connectButton!.classList.toggle("hidden", !hasMethod);

            // Stay busy through to the flash stage, or the imminent self-disconnect
            // flicks the button back to idle mid-sequence.
            setButtonBusy(connectButton!, connecting || hasTriggeredReboot);
        }

        // Registered first, so the listener picks up whatever the calls below change.
        pico.on("stateChange", updateUI);
        updateUI(pico.getState());

        // BOOTSEL needs a wired connection, so flashing is USB-only.
        const supportsUsb = "serial" in navigator;

        /** "Flash Another Device" returns here without a reload, so arm a fresh connection each time. */
        async function armForBootloaderStage() {
            hasTriggeredReboot = false;

            // Awaited, or setAutoConnect(false) lands on the transport being torn down
            // rather than the fresh one replacing it.
            if (supportsUsb) await pico.setCommunicationMethod("USB");

            // Only an explicit click may connect here, or an authorised port would be
            // rebooted into bootloader mode unprompted.
            pico.setAutoConnect(false);
        }

        void armForBootloaderStage();

        const flashDeviceRoot = root.closest<HTMLDivElement>(".flashDevice");
        if (!flashDeviceRoot) throw new Error("Automatic bootsel must be nested inside .flashDevice");
        flashDeviceRoot.addEventListener("flashdevice:stage-changed", (event) => {
            if ((event as CustomEvent<{ stage: Stage }>).detail.stage === "bootloader") void armForBootloaderStage();
        });

        pico.on("error", (data) => {
            dispatchFlashError(
                root,
                "Couldn't Connect Automatically",
                `${data.message} You can try again above, or follow the manual steps below.`,
            );
        });

        connectButton.addEventListener("click", () => {
            dispatchFlashClearError(root);
            hasTriggeredReboot = false;
            pico.request();
        });
    });
</script>
