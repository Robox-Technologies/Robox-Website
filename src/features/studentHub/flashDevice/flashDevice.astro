---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faTriangleExclamation } from '@fortawesome/free-solid-svg-icons';
import StageStepper from '@/components/stageStepper.astro';
import StageErrorBanner from '@/components/stageErrorBanner.astro';
import AutomaticBootsel from './components/automaticBootsel.astro';
import ManualBootsel from './components/manualBootsel.astro';
import SelectDrive from './components/selectDrive.astro';
import FlashComplete from './components/flashComplete.astro';
import { STAGES, STAGE_LABELS } from './stage';
---
<div class="flashDevice flex flex-col gap-6" data-stage-flow-root>
    <StageStepper namespace="flashdevice" stages={STAGES} stageLabels={STAGE_LABELS} />
    <div class="flashDeviceUnsupported flex items-start gap-3 rounded-xl border-2 border-red bg-red/15 p-4" style="display: none;">
        <FontAwesomeIcon icon={faTriangleExclamation} className="mt-0.5 text-xl text-black" />
        <div>
            <p class="font-bold text-black">Browser Not Supported</p>
            <p class="mt-1 text-sm text-black">
                Flashing your Ro/Box needs the File System Access API, which
                is only available in Chrome or Edge on a desktop computer.
            </p>
        </div>
    </div>
    <StageErrorBanner />
    <div class="stageFlowStages overflow-hidden rounded-3xl bg-white box-shadow transition-[height] duration-300 ease-out motion-reduce:transition-none">
        <div class="stageFlowStage flex flex-col gap-4 p-6" data-stage="bootloader">
            <h2 class="text-xl font-bold text-black">Step 1: Reboot into firmware update mode</h2>
            <p class="text-gray-800">Connect your Ro/Box over USB and we'll ask it to reboot itself into firmware update mode.</p>
            <AutomaticBootsel />
            <ManualBootsel />
        </div>
        <div class="stageFlowStage hidden flex flex-col gap-4 p-6" data-stage="flash">
            <h2 class="text-xl font-bold text-black">Step 2: Select your Ro/Box's drive</h2>
            <SelectDrive />
        </div>
        <div class="stageFlowStage hidden flex flex-col items-start gap-4 p-6" data-stage="done">
            <FlashComplete />
        </div>
    </div>
</div>
<script>
    import { STAGES, isStage } from "./stage";
    import { createStageFlow } from "@/components/stageFlow";

    document.querySelectorAll<HTMLDivElement>(".flashDevice").forEach((root) => {
        const unsupportedBanner = root.querySelector<HTMLDivElement>(".flashDeviceUnsupported");
        const stepper = root.querySelector<HTMLOListElement>(".stageStepper");
        const stagesWrapper = root.querySelector<HTMLDivElement>(".stageFlowStages");
        if (!unsupportedBanner || !stepper || !stagesWrapper) {
            throw new Error("Flash device elements not found");
        }

        if (!("showDirectoryPicker" in window)) {
            unsupportedBanner.style.display = "flex";
            stepper.style.display = "none";
            stagesWrapper.style.display = "none";
            return;
        }

        createStageFlow({
            root,
            namespace: "flashdevice",
            stages: STAGES,
            isStage,
            stageParam: "step",
        });
    });
</script>
