---
import { faUndo, faRedo } from "@fortawesome/free-solid-svg-icons";
import Button from "@/components/button";
import CommunicationSlot from "@/features/editor/components/editorButtons/communicationSlot.astro";
import MainButton from "@/features/editor/components/editorButtons/mainButton";
---

<div class="h-full flex flex-col">
    <div class="bg-gray-100 border-b border-gray-300 flex items-center justify-center gap-4 py-2">
        <Button
            icon={faUndo}
            id="pythonUndoButton"
            className="flex items-center justify-center w-9 h-9 p-0! rounded-full! bg-white text-blue border border-gray-300"
            iconStyle="text-lg"
        />
        <Button
            icon={faRedo}
            id="pythonRedoButton"
            className="flex items-center justify-center w-9 h-9 p-0! rounded-full! bg-white text-blue border border-gray-300"
            iconStyle="text-lg"
        />
    </div>

    <div id="monacoContainer" class="flex-1"></div>

    <div class="bg-gray-100 border-t border-gray-300 flex items-center justify-end gap-4 px-4 py-3">
        <CommunicationSlot />
        <MainButton client:only="react" />
    </div>
</div>
<script>
    import { editor } from 'monaco-editor/editor/editor.api'
    import 'monaco-editor/languages/definitions/python/register'
    import EditorWorker from 'monaco-editor/editor/editor.worker?worker'
    import {
        getProject,
        getProjectIdFromURL,
        editProject,
    } from '@/utils/serialization'
    import { registerCodeProvider } from '@/features/editor/state/codeProvider'
    import { buildPreamble } from '@/features/editor/utils/preamble'
    import dayjs from 'dayjs'

    globalThis.MonacoEnvironment = {
        getWorker: () => new EditorWorker(),
    }

    const container =
        document.querySelector<HTMLDivElement>('#monacoContainer')
    if (!container) throw new Error('Monaco container not found')

    const projectId = getProjectIdFromURL()
    const project = projectId ? await getProject(projectId) : null

    // Both editor bodies render on every load (editorBody.astro picks which
    // one is visible once it knows the project's type) — skip creating the
    // Monaco instance entirely when this isn't a python project, mirroring
    // the equivalent `project.type !== 'block'` guard in loadBlockly.
    if (!project || project.type === 'python') {
        // Colours pulled from the `--color-*` tokens in src/styles/global.css
        // so the editor reads as the same brand palette as the rest of the
        // site (and the Blockly editor's roboxTheme.ts) rather than Monaco's
        // generic `vs` defaults.
        editor.defineTheme('roboxPython', {
            base: 'vs',
            inherit: true,
            rules: [
                { token: 'comment', foreground: '717171', fontStyle: 'italic' },
                // Darker, higher-contrast tints of --color-green/--color-yellow —
                // the raw brand hexes are too light to read as body text on a
                // light background.
                { token: 'string', foreground: '4f7619' },
                { token: 'string.escape', foreground: 'ff6166' },
                { token: 'number', foreground: '916d08', fontStyle: 'bold' },
                { token: 'number.hex', foreground: '916d08', fontStyle: 'bold' },
                { token: 'keyword', foreground: '2588c7', fontStyle: 'bold' },
                { token: 'identifier', foreground: '405c64' },
                { token: 'delimiter', foreground: '717171' },
                { token: 'tag', foreground: 'ff6166' },
            ],
            colors: {
                'editor.background': '#f8f8f8',
                'editor.foreground': '#405c64',
                'editorGutter.background': '#efefef',
                'editorLineNumber.foreground': '#717171',
                'editorLineNumber.activeForeground': '#405c64',
                'editorCursor.foreground': '#2588c7',
                'editor.selectionBackground': '#2588c74d',
                'editor.lineHighlightBackground': '#2588c714',
                'editor.lineHighlightBorder': '#00000000',
                'editorIndentGuide.background': '#c6c6c6',
                'editorIndentGuide.activeBackground': '#2588c7',
            },
        })

        const model = editor.createModel(project?.code ?? '', 'python')
        const codeEditor = editor.create(container, {
            model,
            theme: 'roboxPython',
            automaticLayout: true,
            minimap: { enabled: false },
            fontSize: 14,
        })

        // The robot's firmware expects the roboxlib/machine setup the block
        // editor's generated code also depends on (see buildPreamble) — the
        // user only ever sees/edits their own code, but this is prepended
        // whenever it's sent to the board.
        const preambleCode = buildPreamble(project)
        registerCodeProvider(() => preambleCode + '\n' + codeEditor.getValue())

        let saveTimeoutId = 0
        model.onDidChangeContent(() => {
            if (!projectId) return
            window.clearTimeout(saveTimeoutId)
            saveTimeoutId = window.setTimeout(() => {
                void editProject(projectId, {
                    code: codeEditor.getValue(),
                    time: dayjs(),
                })
            }, 500)
        })

        document
            .querySelector('button#pythonUndoButton')
            ?.addEventListener('click', () => {
                codeEditor.trigger('toolbar', 'undo', null)
            })
        document
            .querySelector('button#pythonRedoButton')
            ?.addEventListener('click', () => {
                codeEditor.trigger('toolbar', 'redo', null)
            })
    }
</script>

<style is:global>
    #monacoContainer .margin {
        border-right: 1px solid #c6c6c6;
    }
</style>
