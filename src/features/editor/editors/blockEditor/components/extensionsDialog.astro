---
import extensions from '@/data/extensions.json'

// Each extension shows the toolbox tab it adds, so students know where to look.
const rows = Object.entries(extensions).map(([key, extension]) => {
    const category = extension.toolbox.categories?.[0]?.category
    return {
        key,
        name: extension.name,
        description: extension.description,
        icon:
            category?.cssconfig.icon.replace('categoryIcon', '').trim() ??
            'fa-solid fa-puzzle-piece',
        categoryStyle: category?.categorystyle,
    }
})
---

<button
    type="button"
    id="extensions-dialog-button"
    class="button-interactive button-interactive-light text-white h-8 w-8 p-0! rounded-full flex items-center justify-center"
    aria-label="Extensions"
>
    <i class="fa-solid fa-puzzle-piece fa-xl"></i>
</button>

<dialog
    id="extensions-dialog"
    aria-labelledby="extensions-dialog-title"
    class="modal fixed inset-0 z-50 m-0 h-screen w-screen max-h-none max-w-none border-0 bg-black/45 p-4 text-black backdrop:bg-black/45 open:flex open:items-center open:justify-center"
>
    <div class="relative flex max-h-[80vh] w-full max-w-lg flex-col rounded-3xl bg-white shadow-2xl">
        <button
            type="button"
            id="extensions-dialog-close"
            class="button-interactive absolute right-4 top-4 rounded-lg px-3 py-2 text-gray-600"
            aria-label="Close extensions"
        >
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="px-8 pt-8 pb-3 pr-16">
            <h2 id="extensions-dialog-title" class="text-3xl font-extrabold leading-tight">
                Extensions
            </h2>
            <p class="mt-1 text-gray-500">Turn on extra blocks for this project.</p>
        </div>

        <ul class="divide-y divide-gray-200 overflow-y-auto px-4 pb-4">
            {rows.map(({ key, name, description, icon, categoryStyle }) => (
                <li class="py-1">
                    <button
                        type="button"
                        role="switch"
                        aria-checked="false"
                        data-extension-toggle={key}
                        class="group button-interactive flex w-full items-center gap-4 rounded-2xl px-4 py-3 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                    >
                        <span
                            class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-gray-400 text-xl text-white"
                            data-category-style={categoryStyle}
                            aria-hidden="true"
                        >
                            <i class={icon}></i>
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block text-lg font-bold">{name}</span>
                            <span class="block text-sm text-gray-500">{description}</span>
                        </span>
                        <span
                            class="flex h-7 w-12 shrink-0 items-center rounded-full bg-gray-200 p-1 transition-colors group-aria-checked:bg-green"
                            aria-hidden="true"
                        >
                            <span class="size-5 rounded-full bg-white shadow transition-[translate] duration-200 group-aria-checked:translate-x-5"></span>
                        </span>
                    </button>
                </li>
            ))}
        </ul>
    </div>
</dialog>

<script>
    import extensions from '@/data/extensions.json'
    import { getProject, getProjectIdFromURL } from '@/utils/serialization'
    import { setUserExtension } from '@/features/editor/editors/blockEditor/utils/serialization'
    import generateToolbox, {
        getExtensionBlockTypes,
        updateToolboxPreservingScroll,
    } from '@/features/editor/editors/blockEditor/utils/toolbox'
    import { toast } from '@/libs/ui/toast'
    import type { ExtensionKey } from 'src/types/extensions'
    import * as Blockly from 'blockly'
    import roboxTheme from '@/features/editor/editors/blockEditor/config/roboxTheme'
    import '@/features/editor/editors/blockEditor/config/toolboxIcons'
    import { dom, library } from '@fortawesome/fontawesome-svg-core'
    import { faPuzzlePiece, faXmark } from '@fortawesome/free-solid-svg-icons'

    library.add(faPuzzlePiece, faXmark)
    dom.watch()

    const dialog = document.getElementById('extensions-dialog') as HTMLDialogElement | null
    const button = document.getElementById('extensions-dialog-button') as HTMLButtonElement | null
    const closeButton = document.getElementById('extensions-dialog-close') as HTMLButtonElement | null
    const toggleButtons = Array.from(document.querySelectorAll('[data-extension-toggle]')) as HTMLButtonElement[]

    const setToggleState = (extensionKey: string, enabled: boolean) => {
        document
            .querySelector(`[data-extension-toggle="${extensionKey}"]`)
            ?.setAttribute('aria-checked', String(enabled))
    }

    // Tiles take their toolbox category's colour from the Blockly theme.
    for (const tile of document.querySelectorAll<HTMLElement>('[data-category-style]')) {
        const style = roboxTheme.categoryStyles[tile.dataset.categoryStyle ?? '']
        if (style?.colour) {
            tile.style.backgroundColor = Blockly.utils.parsing.replaceMessageReferences(style.colour)
        }
    }

    if (dialog && button) {
        const closeDialog = () => {
            if (!dialog.open) return
            dialog.close()
        }

        button.addEventListener('click', (event) => {
            event.stopPropagation()

            if (dialog.open) {
                closeDialog()
            } else {
                void syncToggles().then(() => dialog.showModal())
            }
        })

        closeButton?.addEventListener('click', closeDialog)

        document.addEventListener('click', (event) => {
            if (
                dialog.open &&
                event.target instanceof Element &&
                event.target === dialog
            ) {
                closeDialog()
            }
        })

        dialog.addEventListener('cancel', (event) => {
            event.preventDefault()
            closeDialog()
        })

        // Read on every open: the editor can turn extensions on after load.
        const syncToggles = async () => {
            const projectId = getProjectIdFromURL()
            if (!projectId) return
            const project = await getProject(projectId)
            for (const extensionKey of Object.keys(extensions) as ExtensionKey[]) {
                setToggleState(extensionKey, project?.extensions[extensionKey] === true)
            }
        }

        for (const toggle of toggleButtons) {
            const extensionKey = toggle.dataset.extensionToggle as
                | ExtensionKey
                | undefined
            if (!extensionKey) continue

            toggle.addEventListener('click', async () => {
                const enabled = toggle.getAttribute('aria-checked') !== 'true'
                const workspace = Blockly.getMainWorkspace()

                if (!enabled && workspace instanceof Blockly.WorkspaceSvg) {
                    const extensionBlocks = getExtensionBlockTypes(extensionKey)
                    const blocksInUse = workspace
                        .getAllBlocks(false)
                        .filter((block) => extensionBlocks.has(block.type))
                    if (blocksInUse.length > 0) {
                        toast.warning({
                            title: `Can't turn off ${extensions[extensionKey].name}`,
                            message: `Your project uses ${blocksInUse.length} of its blocks. Remove them first.`,
                        })
                        return
                    }
                }

                setToggleState(extensionKey, enabled)
                await setUserExtension(extensionKey, enabled)

                const toolbox = await generateToolbox()
                if (workspace instanceof Blockly.WorkspaceSvg) {
                    updateToolboxPreservingScroll(workspace, toolbox)
                }
            })
        }
    }
</script>