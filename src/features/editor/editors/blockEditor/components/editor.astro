---
import "../styles/toolbox.scss";
import EditorButtons from "./editorButtons/editorButtons.astro";
---

<div class="flex-1 flex relative">
    <div
        id="editorLoadingOverlay"
        class="fixed inset-0 z-9999 flex flex-col items-center justify-center gap-4 bg-white/95 backdrop-blur-sm text-black pointer-events-auto"
    >
        <div class="h-14 w-14 animate-spin rounded-full border-4 border-gray-300 border-t-red"></div>
        <div class="text-lg font-semibold">Loading editor...</div>
    </div>
    <div id="blocklyDiv" class="flex-1">
        
    </div>
    <EditorButtons />

</div>
<script>
    import { faArrowsRotate,faFlag, faCog, faRepeat, faPlus, faTableList, faEye, faRobot, faTruckMonster, faX, faGears,  } from "@fortawesome/free-solid-svg-icons";
    import { dom, library } from "@fortawesome/fontawesome-svg-core";
    library.add(faArrowsRotate, faFlag, faCog, faRepeat, faPlus, faTableList, faEye, faRobot, faTruckMonster, faX, faGears);
    dom.watch()
</script>
<script>
    // Setting up Blockly
    import * as Blockly from 'blockly/core';
    import { loadBlockly, saveBlockly, generateCode } from "../utils/serialization";
    import generateToolbox from '../utils/toolbox';
    import { registerControls } from '../utils/controls';
    import { registerCodeProvider } from '@/features/editor/state/codeProvider';
    registerCodeProvider(() =>
        generateCode(Blockly.getMainWorkspace() as Blockly.WorkspaceSvg),
    );
    import { registerFieldColour } from '@blockly/field-colour';
    registerFieldColour();
    // Required for some reason as it does not apply automatically 
    import * as En from 'blockly/msg/en';
    // @ts-expect-error its so odd why it cares
    Blockly.setLocale(En);
    import { BlocklyConfig } from '../config/blockly';
    import 'blockly/blocks';
    // Dynamically import all blocks in the blocks directory
    import.meta.glob('../config/blocks/*.ts', { eager: true });
    import.meta.glob('../config/generators/*.ts', { eager: true });

    const workspace = Blockly.inject('blocklyDiv', BlocklyConfig);

    const overlay = document.getElementById('editorLoadingOverlay')
    const hideOverlay = () => {
        if (overlay) {
            overlay.remove()
        }
    }

    // Load the saved workspace, then swap in the project's extension-aware
    // toolbox once storage has resolved (both are async).
    (async () => {
        try {
            await loadBlockly(workspace);
            workspace.updateToolbox(await generateToolbox());
            await new Promise((resolve) => requestAnimationFrame(resolve))
        } finally {
            hideOverlay()
        }
    })();
    // Saving every time a change is made to the workspace, except for UI events (like dragging blocks)
    workspace.addChangeListener((event) => {
        if (event.isUiEvent) return;
        saveBlockly(workspace);
    });
    workspace.addChangeListener(Blockly.Events.disableOrphans);
    registerControls(workspace);


</script>
