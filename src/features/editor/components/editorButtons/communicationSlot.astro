---
import CommunicationMethodToggle from "@/components/communicationMethodToggle.astro";
import DisconnectButton from "./disconnectButton.astro";

// The iOS app only ever talks over its own BLE plugin, so there's no method
// to pick — the toggle doesn't ship in that build at all.
const isIOSBuild = process.env.IOS_BUILD === "true";
---
<div class="communicationSlot" data-ios-build={isIOSBuild ? "true" : "false"}>
    {!isIOSBuild && <CommunicationMethodToggle />}
    <DisconnectButton />
</div>
<style>
    /* One shared cell, so the disconnect pill takes the toggle's exact spot. */
    .communicationSlot {
        display: grid;
        justify-items: end;
        align-items: center;
    }
    .communicationSlot > :global(*) {
        grid-area: 1 / 1;
    }
</style>
<script>
    // Astro includes this script once, but both editor bodies render a copy of the
    // component, so wire up every instance.
    import { pico } from "@/libs/communication/communicate";
    import { ConnectionStatus } from "src/types/communication";
    import type { PicoState } from "src/types/communication";

    const roots = document.querySelectorAll<HTMLDivElement>(".communicationSlot");
    if (roots.length === 0) throw new Error("Communication slot root not found");

    if (roots[0].dataset.iosBuild === "true") {
        // Set once regardless of how many instances are on the page.
        void pico.setCommunicationMethod("iOSBluetooth");
    } else {
        const params = new URLSearchParams(window.location.search);
        const handoffMethod = params.get("connectionMethod");
        const handoffDeviceId = params.get("deviceId");
        const handoffMethods = new Set(["USB", "WebBluetooth", "iOSBluetooth"]);
        if (handoffMethod && handoffDeviceId && handoffMethods.has(handoffMethod)) {
            void (async () => {
                try {
                    await pico.setCommunicationMethod(
                        handoffMethod as "USB" | "WebBluetooth" | "iOSBluetooth",
                    );
                    await pico.autoConnect(handoffDeviceId);
                } catch (error) {
                    console.error("Editor connection handoff failed", error);
                }
            })();
        }

        // Once there's a connection there's no method left to pick, so the
        // toggle makes way for the disconnect button (which shows itself).
        const showsToggle = (status: ConnectionStatus) =>
            status === ConnectionStatus.DISCONNECTED ||
            status === ConnectionStatus.CONNECTING

        roots.forEach((root) => {
            const toggle = root.querySelector<HTMLDivElement>(
                ".communicationMethodToggle",
            );
            if (!toggle) throw new Error("Communication method toggle not found");

            const updateVisibility = (state: PicoState) => {
                toggle.classList.toggle(
                    "hidden",
                    !showsToggle(state.connectionStatus),
                );
            }

            updateVisibility(pico.getState());
            pico.on("stateChange", updateVisibility);
        });
    }
</script>
