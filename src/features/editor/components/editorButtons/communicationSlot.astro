---
import TerminalDialog from "../terminalDialog";
import CommunicationMethodToggle from "@/components/communicationMethodToggle.astro";

// The iOS app only ever talks over its own BLE plugin, so there's no method
// to pick — the toggle doesn't ship in that build at all.
const isIOSBuild = process.env.IOS_BUILD === "true";
---
<div class="communicationSlot" data-ios-build={isIOSBuild ? "true" : "false"}>
    {!isIOSBuild && <CommunicationMethodToggle />}
    <div class:list={["terminalDialogSlot", { hidden: !isIOSBuild }]}>
        <TerminalDialog client:only="react" />
    </div>
</div>
<script>
    // The block and python editor bodies both render (one hidden) on every
    // editor page load, and each uses its own copy of this component — so
    // this script, which Astro only includes once, has to wire up every
    // instance it finds rather than assuming there's a single one.
    import { pico } from "@/libs/communication/communicate";
    import { ConnectionStatus } from "src/types/communication";
    import type { PicoState } from "src/types/communication";

    const roots = document.querySelectorAll<HTMLDivElement>(".communicationSlot");
    if (roots.length === 0) throw new Error("Communication slot root not found");

    if (roots[0].dataset.iosBuild === "true") {
        // Set once regardless of how many instances are on the page.
        void pico.setCommunicationMethod("iOSBluetooth");
    } else {
        // Once we're actually talking to a Ro/Box there's no method left to
        // pick, so the toggle makes way for the terminal button.
        const isConnected = (status: ConnectionStatus) =>
            status !== ConnectionStatus.CONNECTING &&
            status !== ConnectionStatus.DISCONNECTED &&
            status !== ConnectionStatus.DISCONNECTING

        roots.forEach((root) => {
            const toggle = root.querySelector<HTMLDivElement>(
                ".communicationMethodToggle",
            );
            const terminalSlot = root.querySelector<HTMLDivElement>(
                ".terminalDialogSlot",
            );
            if (!toggle || !terminalSlot)
                throw new Error("Communication slot elements not found");

            const updateVisibility = (state: PicoState) => {
                const connected = isConnected(state.connectionStatus);
                toggle!.classList.toggle("hidden", connected);
                terminalSlot!.classList.toggle("hidden", !connected);
            }

            updateVisibility(pico.getState());
            pico.on("stateChange", updateVisibility);
        });
    }
</script>
