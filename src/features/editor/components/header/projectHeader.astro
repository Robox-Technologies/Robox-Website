---
import Button from "@/components/button";
import ProjectRename from "./projectRename.astro";
import ProjectSettings from "./projectSettings.astro";
import { faChevronLeft } from "@fortawesome/free-solid-svg-icons";

const isIOSBuild = process.env.IOS_BUILD === 'true';
---
<div class="editorHeader flex flex-row justify-between items-center h-18 bg-red px-8">
    <Button 
        href="../"
        icon={faChevronLeft}
        iconStyle="fa-xl"
        className="button-interactive-light text-white h-8 w-8 p-0! rounded-full! flex justify-center items-center"
        onClick={isIOSBuild ? (event: React.MouseEvent<HTMLButtonElement>) => {
            event.preventDefault(); 
            window.history.back();
        } : undefined}
    />
    <ProjectRename />
    <div class="flex flex-row gap-4">
        <ProjectSettings />

    </div>
    
</div>