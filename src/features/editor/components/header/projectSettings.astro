---
import { faEyeDropper, faSliders, faScrewdriver, faDownload, faGear } from "@fortawesome/free-solid-svg-icons"
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome"
import Button from "@/components/button"
import RenameDeviceDialog from "./renameDeviceDialog.astro"
import ColorCalibration from "@/features/studentHub/calibration/colorCalibration/colorCalibration.astro"
import MotorCalibration from "@/features/studentHub/calibration/motorCalibration/motorCalibration.astro"
import FlashDevice from "@/features/studentHub/flashDevice/flashDevice.astro"

// Firmware updates need the File System Access API, which the iOS app doesn't have.
const isIOSBuild = process.env.IOS_BUILD === "true"
---

<div class="project-settings relative">
    <button
        type="button"
        id="project-settings-button"
        class="button-interactive button-interactive-light text-white h-8 w-8 p-0! rounded-full flex justify-center items-center transition-transform duration-300 ease-in-out"
        aria-label="Project settings"
    >
        <FontAwesomeIcon icon={faGear} size="lg"/>

    </button>

    <dialog
        id="project-settings-dialog"
        class="modal absolute top-1/2 right-full -translate-x-full rounded-lg drop-shadow-xl ml-2 transform border-2 border-black p-0! z-50"
    >
        <div class="modal-content bg-white min-h-25 w-50 rounded flex flex-col">
            <button
                type="button"
                data-open-modal="calibrate-colours-dialog"
                data-requires-connection
                class="button-interactive text-black! text-md p-2 text-left flex items-center gap-2 rounded-none w-full justify-start"
                disabled
                aria-disabled="true"
            >
                <FontAwesomeIcon icon={faEyeDropper}/>
                Calibrate Colour
            </button>
            <button
                type="button"
                data-open-modal="calibrate-motors-dialog"
                data-requires-connection
                class="button-interactive text-black! text-md p-2 text-left flex items-center gap-2 rounded-none w-full justify-start"
                disabled
                aria-disabled="true"
            >
                <FontAwesomeIcon icon={faSliders}/>
                Calibrate Motors
            </button>
            <RenameDeviceDialog />
            {!isIOSBuild && (
                <button
                    type="button"
                    data-open-modal="update-firmware-dialog"
                    class="button-interactive text-black! text-md p-2 text-left flex items-center gap-2 rounded-none w-full justify-start"
                >
                    <FontAwesomeIcon icon={faScrewdriver} />
                    Update Firmware
                </button>
            )}
            <Button
                type="button"
                id="project-export-button"
                className="text-black! text-md p-2 text-left flex items-center gap-2 rounded-none w-full justify-start"
            >
                <FontAwesomeIcon className="text-green" icon={faDownload} />
                Export Project
            </Button>
        </div>
    </dialog>
    {/* Outside the menu, which hides when it closes. Calibration opens while connected, so no Connect step. */}
    <ColorCalibration showConnect={false} />
    <MotorCalibration showConnect={false} />
    {!isIOSBuild && <FlashDevice />}
</div>

<script>
    import { pico } from "@/libs/communication/communicate";

    const settingsDialog = document.getElementById(
        'project-settings-dialog',
    ) as HTMLDialogElement | null
    const settingsButton = document.getElementById(
        'project-settings-button',
    ) as HTMLButtonElement | null

    if (settingsDialog && settingsButton) {
        let gearRotation = 0

        const updateRotation = () => {
            settingsButton.style.transform = `rotate(${gearRotation}deg)`
        }

        const closeDialog = () => {
            if (!settingsDialog.open) return
            settingsDialog.close()
            settingsDialog.classList.remove('open')
            gearRotation += 45
            updateRotation()
        }

        settingsButton.addEventListener('click', (event) => {
            event.stopPropagation()

            const isOpen = settingsDialog.classList.contains('open')

            if (isOpen) {
                settingsDialog.classList.remove('open')
                settingsDialog.close()
                gearRotation += 45
            } else {
                settingsDialog.classList.add('open')
                settingsDialog.show()
                gearRotation += 45
            }

            updateRotation()
        })

        document.addEventListener('click', (event) => {
            if (
                settingsDialog.open &&
                event.target instanceof Element &&
                !event.target.closest('.modal')
            ) {
                closeDialog()
            }
        })

        settingsDialog
            .querySelectorAll('[data-open-modal]')
            .forEach((item) => item.addEventListener('click', closeDialog))
    }

    // Calibration needs a connected Ro/Box; the dialogs skip their Connect step.
    const connectionItems = document.querySelectorAll<HTMLButtonElement>(
        ".project-settings [data-requires-connection]",
    );
    const updateConnectionItems = () => {
        const connected = pico.isConnected();
        connectionItems.forEach((item) => {
            item.disabled = !connected;
            item.setAttribute("aria-disabled", String(!connected));
        });
    };
    pico.on("stateChange", updateConnectionItems);
    updateConnectionItems();
</script>

<script>
    import { exportProject, getProjectIdFromURL } from '@/utils/serialization'

    const exportButton = document.getElementById('project-export-button')

    exportButton?.addEventListener('click', () => {
        const projectId = getProjectIdFromURL()
        if (!projectId) return
        void exportProject(projectId)
    })
</script>