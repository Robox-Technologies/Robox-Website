---
---

<div class="project-rename flex items-center justify-center">
    {/* Not a <form>: WebKit implicitly submits a single-input form without a `submit`
         event, so preventDefault() can't stop it navigating away from ?project=... */}
    <div class="flex gap-4 bg-white rounded-lg box-shadow">
        <label class="sr-only" for="project-name-input">Project name</label>
        <input
            type="text"
            name="projectName"
            id="project-name-input"
            value="Untitled Project"
            autocomplete="off"
            enterkeyhint="done"
            class="border border-gray-300 p-2 rounded-sm w-42 text-black"
            data-project-rename-input
            disabled
        />
    </div>
</div>

<script type="module">
    import { editProject, getProject, getProjectIdFromURL } from '@/utils/serialization'

    const DEFAULT_PROJECT_NAME = 'Untitled Project'

    const input = document.querySelector('[data-project-rename-input]')

    if (!(input instanceof HTMLInputElement)) {
        throw new Error('Project rename elements are missing')
    }

    const projectId = getProjectIdFromURL()
    let saveTimeoutId = 0

    const enableEditor = (name) => {
        input.value = name
        input.disabled = false
    }

    const save = () => {
        if (!projectId) return

        void editProject(projectId, {
            name: input.value.trim() || DEFAULT_PROJECT_NAME,
        })
    }

    const scheduleSave = () => {
        if (!projectId) return

        if (saveTimeoutId) {
            window.clearTimeout(saveTimeoutId)
        }

        saveTimeoutId = window.setTimeout(save, 250)
    }

    const flushSave = () => {
        if (!saveTimeoutId) return

        window.clearTimeout(saveTimeoutId)
        saveTimeoutId = 0
        save()
    }

    input.addEventListener('input', scheduleSave)
    input.addEventListener('blur', flushSave)

    input.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return

        // Return commits and dismisses the keyboard; it never bubbles as a submit gesture.
        event.preventDefault()
        flushSave()
        input.blur()
    })

    const loadProjectName = async () => {
        try {
            const project = projectId ? await getProject(projectId) : null
            enableEditor(project?.name || DEFAULT_PROJECT_NAME)
        } catch {
            enableEditor(DEFAULT_PROJECT_NAME)
        }
    }

    void loadProjectName()
</script>
